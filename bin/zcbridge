#!/usr/bin/env python3
"""zcbridge - drive the ZCode desktop app (dev.zcode.app) from an agent. Mac mini only.

Surfaces used (and nothing else):
  * ZCode's own window through macOS accessibility (helper `zcax`, pid of dev.zcode.app only, never coordinates)
  * ZCode's local stores, read-only: ~/.zcode/cli/db/db.sqlite, ~/.zcode/v2/tasks-index.sqlite
Never touched: credentials.json, tokens, cookies, any Z.ai/ZCode network endpoint, `zcode login`, /Applications/ZCode.app.

Every command prints one JSON object (JSON lines for `watch`). Exit code 0 = ok, 1 = error ({"ok":false,"error":{code,message}}).
Focus policy. Default is --background: ZCode is never made frontmost and no keystroke is ever sent. A minimized or hidden window is
shown again without activating the app (the page ignores UI events while hidden) and put back when the command ends. Text goes in through
the composer's own context menu (Paste) with a 150-300 ms activation of ZCode that hands focus back at once (zcax bgpaste); everything else
is AXPress / AXIncrement on ZCode's elements. Steps that truly need keystrokes (project-add: the folder panel; a new project in `send
--folder`) fail with foreground_required unless --foreground is given, which keeps the old path (activate ZCode, paste, keys, restore).
Every UI result carries "focus": {before, after, unchanged}. Pure AX actions address the ZCode process only.
Concurrency. ZCode runs different tasks (sessions) at the same time, so the lock is held only for the steps that drive the window (choose
project/model/mode, paste, press Send/Stop/Allow/Deny, archive); starting a task releases it as soon as Send is pressed, and reading status,
results and waiting never take it. Tasks are told apart by their own session ids. How many tasks may run at once is a counting limit:
ZCODE_MAX_PARALLEL (env) or ~/.zcode-bridge/config.json {"max_parallel": N}, default 3, 0 = no limit. `send`/`continue` take a slot (kept in
~/.zcode-bridge/slots.json) and wait for one up to --queue-timeout seconds (default 900; 0 = fail at once with parallel_limit); a slot is
free again when its task is completed, failed or cancelled. `zcbridge slots` shows them.
"""
import argparse, contextlib, fcntl, hashlib, json, os, re, sqlite3, subprocess, sys, time, uuid

HOME = os.path.expanduser("~")
HERE = os.path.dirname(os.path.realpath(__file__))
ZCAX = os.environ.get("ZCBRIDGE_ZCAX") or next((p for p in (os.path.join(HERE, "zcax"), os.path.join(HOME, ".agents/bin/zcax"), os.path.join(HOME, ".local/bin/zcax")) if os.path.exists(p)), "zcax")
DBP = os.path.join(HOME, ".zcode/cli/db/db.sqlite")
IDXP = os.path.join(HOME, ".zcode/v2/tasks-index.sqlite")
STATE = os.path.join(HOME, ".zcode-bridge")
BUNDLE = "dev.zcode.app"
VERSION = "0.5.1"
FOREGROUND = False                      # --foreground: the old path (activate ZCode, paste with Cmd+V, press keys); default is background
TRACE = []                              # menus (popup buttons) pressed in this run, for the ui_trace of a send/continue result
TRACE_T0 = time.time()
CREATED = {}                            # set by choose_workspace when this run registered the project
FOCUS = {}                              # frontmost app before the first UI operation of this run
MODELS = {"flash": "GLM-5.3-Flash", "glm": "GLM-5.3"}
EFFORT = {"low": 0, "high": 1, "max": 2}
MODES = {"ask": "Ask before changes", "plan": "Plan mode", "auto": "Autonomous mode", "full": "Full access"}   # auto and full need an explicit --allow-autonomous / --allow-full
DONE = ("completed", "error", "cancelled")
# Labels the bridge refuses to press unless a command passes allow=True: they log out, delete, spend or widen permissions.
DENY = re.compile(r"disconnect|unlink|sign ?out|log ?out|delete|remove|upgrade|reset|refer a friend|full access|always allow|trust", re.I)


class BridgeError(Exception):
    def __init__(self, code, message, **extra):
        super().__init__(message); self.code, self.extra = code, extra


def log(msg):
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "bridge.log"), "a") as f:
        f.write("%s %s\n" % (time.strftime("%F %T"), msg))


# ---------------------------------------------------------------- accessibility helper
def zc(*a, nth=0, check=True, timeout=40):
    if a and a[0] in ("press", "pressup") and len(a) > 1 and a[1] == "AXPopUpButton":
        TRACE.append(dict(control=str(a[2]) if len(a) > 2 else "", t_ms=int((time.time() - TRACE_T0) * 1000)))   # every menu this run opens
    env = dict(os.environ, ZCAX_NTH=str(nth))
    if os.environ.get("ZCBRIDGE_TRACE"): log("zcax %s" % " ".join(str(x)[:40] for x in a))
    try:
        r = subprocess.run([ZCAX, *a], capture_output=True, text=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        raise BridgeError("ax_timeout", "zcax %s timed out" % (a[0],))
    if check and (r.returncode or r.stdout.startswith("ERR")):
        out = r.stdout.strip()
        code = "not_running" if "zcode-not-running" in out else "no_window" if "no-window" in out else "ui_element_missing"
        raise BridgeError(code, "zcax %s: %s" % (" ".join(map(str, a)), out))
    return r.stdout


def dump(depth=80):
    return zc("dump", str(depth))


def retry(fn, tries=3, delay=0.8, codes=("ui_element_missing", "ax_timeout")):
    for i in range(tries):
        try:
            return fn()
        except BridgeError as e:
            if e.code not in codes or i == tries - 1:
                raise
            time.sleep(delay)


def frontmost():
    return zc("frontmost", check=False).strip()


def win_state():
    m = re.search(r"minimized=(\d) hidden=(\w+)", zc("window", "state", check=False))
    return dict(minimized=bool(m and m.group(1) == "1"), hidden=bool(m and m.group(2) == "true"))


def reveal():
    """Background mode: a minimized or hidden window is shown again WITHOUT activating the app, because the page runs no UI events
    while hidden. Returns the state to put back."""
    st = win_state()
    if st["hidden"]: zc("unhide", check=False)
    if st["minimized"]: zc("window", "unmin", check=False)
    if st["hidden"] or st["minimized"]:
        end = time.time() + 5
        while time.time() < end and any(win_state().values()): time.sleep(0.15)
        time.sleep(0.7)
    return st


def conceal(st):
    if st["minimized"]: zc("window", "min", check=False)
    if st["hidden"]: time.sleep(0.2); zc("hide", check=False)


def guard(wait=12.0):
    """Foreground mode only: abort unless ZCode itself is frontmost (before a keystroke or paste). Background mode needs no focus."""
    if not FOREGROUND: return
    end = time.time() + wait
    while time.time() < end:
        if frontmost() == BUNDLE:
            return
        zc("activate", check=False); time.sleep(0.3)
    raise BridgeError("not_frontmost", "ZCode is not frontmost (%s has focus); nothing was sent" % frontmost())


def keys(script):
    if not FOREGROUND:
        raise BridgeError("foreground_required", "this step sends keystrokes, which need ZCode frontmost; background mode never sends them (re-run with --foreground)")
    guard()
    subprocess.run(["osascript", "-e", 'tell application "System Events" to tell process "ZCode" to ' + script], check=True, timeout=20)


def popup_open():
    return composer_snapshot().get("menu_open", False)


def esc(trigger=None):
    if FOREGROUND:
        keys("key code 53"); return
    if not trigger: return
    state = composer_snapshot()
    if not state.get("menu_open"): return
    n = len(TRACE)
    zc("press", trigger[0], trigger[1], nth=trigger[2] if len(trigger) > 2 else 0, check=False)
    del TRACE[n:]
    wait_snapshot(lambda s: not s.get("menu_open"))


PASTE_CHUNK = 8000   # ZCode turns ONE paste of 15360+ characters into a "Pasted text" attachment, so long prompts go in as several pastes below that


def paste_chunks(text, size=PASTE_CHUNK):
    """Split at line breaks (hard split inside a line longer than the chunk) so no chunk reaches the attachment threshold."""
    out = []
    while len(text) > size:
        cut = text.rfind("\n", size // 2, size)
        cut = cut + 1 if cut > 0 else size
        out.append(text[:cut]); text = text[cut:]
    if text: out.append(text)
    return out


def u16(t):
    return len(t.encode("utf-16-le")) // 2


def composer_len():
    m = re.search(r"len=(\d+)", zc("textlen", "AXTextArea", "", check=False))
    return int(m.group(1)) if m else None


def paste(text, probe=None, target=("AXTextArea", "")):
    """Background: zcax bgpaste (context-menu Paste inside a 150-300 ms activation that returns focus at once, clipboard restored), one
    call per chunk of PASTE_CHUNK characters; zcax confirms each chunk by the composer's tail and growth, and a failed chunk clears the
    composer and restarts the whole text once. Foreground, Cyrillic-safe: put a chunk on the clipboard, Cmd+V into the focused ZCode
    field, restore the clipboard only after the chunk is visible (the keystroke can lag, and a too-early restore pastes the OLD clipboard)."""
    text = text.strip(); pieces = paste_chunks(text)
    if not FOREGROUND:
        for attempt in range(2):
            for i, piece in enumerate(pieces):
                started = time.monotonic()
                r = zc("bgpaste", target[0], target[1], piece if i < len(pieces) - 1 else piece.rstrip(), check=False, timeout=90)
                elapsed = int((time.monotonic() - started) * 1000)
                if not r.startswith("OK"):
                    log("bgpaste failed (chunk %d/%d attempt %d, %dms): %s" % (i + 1, len(pieces), attempt + 1, elapsed, r.strip()))
                    if "text-not-visible" in r:
                        # The renderer can replace the AX editor or finish its queued paste just after the deadline.
                        observed = zc("textlen", target[0], target[1], check=False)
                        match = re.search(r"len=(\d+).*tail=(.*)", observed)
                        prefix = "".join(pieces[:i + 1]).rstrip()
                        probe = piece.rstrip()[-24:].replace("\n", "\\n")
                        if match and int(match.group(1)) >= u16(prefix) - 2 and match.group(2).strip().endswith(probe):
                            log("bgpaste recovered delayed chunk %d/%d without clearing" % (i + 1, len(pieces))); continue
                    break
                log("bgpaste %d/%d attempt=%d total=%dms %s" % (i + 1, len(pieces), attempt + 1, elapsed, r.strip()))
            else: return True
            zc("bgclear", target[0], target[1], check=False, timeout=60)
        return False
    old = subprocess.run(["pbpaste"], capture_output=True).stdout
    try:
        for attempt in range(2):
            ok = True
            for piece in pieces:
                before = composer_len() or 0
                subprocess.run(["pbcopy"], input=piece.encode(), check=True); time.sleep(0.2)
                keys('keystroke "v" using {command down}')
                need = before + u16(piece) - 2; end = time.time() + 8 + len(piece) / 1500
                while time.time() < end and (composer_len() or 0) < need: time.sleep(0.4)
                if (composer_len() or 0) < need: ok = False; break
            if ok: return True
            keys('keystroke "a" using {command down}'); keys("key code 51"); time.sleep(0.5)   # wrong or no text: clear and retry once
        return False
    finally:
        subprocess.run(["pbcopy"], input=old)


def press(role, q, nth=0, allow=False, wait=0.8):
    if DENY.search(q) and not allow:
        raise BridgeError("label_denied", "refusing to press %r (destructive or permission-widening label)" % q)
    r = zc("press", role, q, nth=nth); time.sleep(wait); return r


def exists(role, q):
    return zc("exists", role, q, check=False).strip() == "1"


def wait_for(role, q, timeout=8.0):
    end = time.time() + timeout
    while time.time() < end:
        if exists(role, q): return True
        time.sleep(0.4)
    raise BridgeError("ui_element_missing", "%s %r did not appear within %ss" % (role, q, timeout))


def first(line):
    """First non-empty field of a `zcax find` line (title | description | value)."""
    return next((x.strip() for x in line.split("|") if x.strip()), "")


def menu_items():
    """Items of the open menu as [(label, checked)]; label is the AXTitle (or description/value)."""
    res = []
    for l in zc("find", "AXMenuItem", "", check=False).splitlines():
        p = [x.strip() for x in l.split("|")]
        if any(p): res.append([first(l), p[-1] if len(p) > 2 else ""])
    return res


def pick_menu(item, exact=True, allow=False):
    q = ("=" + item) if exact else item
    end = time.time() + 4
    while time.time() < end and not exists("AXMenuItem", q):
        if exact and exists("AXMenuItem", item): q = item; break
        time.sleep(0.3)
    return press("AXMenuItem", q, allow=allow)


@contextlib.contextmanager
def ui_lock(timeout=None):
    timeout = timeout or float(os.environ.get("ZCBRIDGE_LOCK_TIMEOUT") or 300)
    os.makedirs(STATE, exist_ok=True)
    f = open(os.path.join(STATE, "ui.lock"), "w"); end = time.time() + timeout
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB); break
        except OSError:
            if time.time() > end: raise BridgeError("busy", "another zcbridge UI operation holds the lock")
            time.sleep(0.5)
    prev = None; st0 = None
    try:
        prev = frontmost(); FOCUS.setdefault("before", prev)
        st0 = reveal()
        if prev != BUNDLE:
            subprocess.run(["open", "-b", BUNDLE], capture_output=True, timeout=10, check=True)
            if frontmost() != BUNDLE: zc("activate")
        yield prev
    finally:
        # hand the desktop back to whatever the owner was using (background: only if something moved focus)
        try:
            if st0: conceal(st0)
            if prev and prev != BUNDLE and prev not in ("none", "") and (FOREGROUND or frontmost() != prev):
                subprocess.run(["osascript", "-e", 'tell application id "%s" to activate' % prev], timeout=10, capture_output=True)
        except Exception:
            pass
        fcntl.flock(f, fcntl.LOCK_UN); f.close()


# ---------------------------------------------------------------- stores (read-only)
CONNECTIONS = {}


def conn(path):
    if path not in CONNECTIONS:
        if not os.path.exists(path): raise BridgeError("store_missing", "%s not found" % path)
        c = sqlite3.connect("file:%s?mode=ro" % path, uri=True, timeout=10, isolation_level=None)
        c.row_factory = sqlite3.Row; CONNECTIONS[path] = c
    return CONNECTIONS[path]


def projects():
    c = conn(IDXP)
    return [dict(id=r["project_id"], name=r["name"], roots=[x[0] for x in c.execute("select root_path from project_roots where project_id=? order by position", (r["project_id"],))])
            for r in c.execute("select project_id,name from projects where deleted=0")]


def git_root(folder):
    try:
        r = subprocess.run(["git", "-C", folder, "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=10)
        return os.path.realpath(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None
    except Exception:
        return None


def find_project(folder, enclosing=True):
    """The ZCode project of a folder: a project whose root is the folder (real path), else, with enclosing=True, the project of the
    git repository the folder lies in."""
    real = os.path.realpath(folder); ps = projects()
    hit = next((p for p in ps if real in p["roots"]), None)
    if hit or not enclosing: return hit
    root = git_root(real)
    return next((p for p in ps if root and root in p["roots"]), None) if root and root != real else None


def session_row(sid):
    r = conn(DBP).execute("select * from session where id=?", (sid,)).fetchone()
    if not r: raise BridgeError("no_such_task", "no session %s in ZCode's db" % sid)
    return r


def user_messages(c, sid):
    return [(r["id"], r["time_created"]) for r in c.execute("select id,time_created from message where session_id=? and json_extract(data,'$.role')='user' and coalesce(json_extract(data,'$.metadata.visibility'),'')!='model-only' order by time_created", (sid,))]


def pending(sid):
    """Tool calls waiting for the owner's approval (tool_usage.approval_status='requested') with their input from the tool part."""
    c = conn(DBP); res = []
    for t in c.execute("select tool_call_id,tool_name,side_effect_scope,read_only,destructive from tool_usage where session_id=? and approval_status='requested' and status='running'", (sid,)):
        inp = None
        for (d,) in c.execute("select data from part where session_id=? and data like ?", (sid, '%' + t["tool_call_id"] + '%')):
            j = json.loads(d)
            if j.get("type") == "tool" and j.get("callID") == t["tool_call_id"]:
                inp = (j.get("state") or {}).get("input")
        res.append(dict(call_id=t["tool_call_id"], tool=t["tool_name"], scope=t["side_effect_scope"], read_only=bool(t["read_only"]), destructive=bool(t["destructive"]), input=inp))
    return res


def turn_error(c, sid, code):
    """The model error behind a failed turn: turn_usage keeps only UNKNOWN_ERROR, the last assistant message keeps the provider's
    code and text (2026-10-30: «user concurrency limit exceeded», 429 of the Start Plan, showed up as UNKNOWN_ERROR)."""
    row = c.execute("select data from message where session_id=? and json_extract(data,'$.role')='assistant' and json_extract(data,'$.error') is not null order by time_created desc limit 1", (sid,)).fetchone()
    data = ((json.loads(row["data"]) if row else {}).get("error") or {}).get("data") or {}
    detail = ": ".join(str(x) for x in (data.get("code"), data.get("message")) if x)
    return detail or code


def task_state(sid):
    c = conn(DBP); s = session_row(sid)
    users = user_messages(c, sid)
    last = users[-1][0] if users else None
    t = c.execute("select * from turn_usage where session_id=? and user_message_id=? order by started_at desc limit 1", (sid, last)).fetchone() if last else None
    if t is None:
        t = c.execute("select * from turn_usage where session_id=? order by started_at desc limit 1", (sid,)).fetchone()
        if t and last and users and t["started_at"] < users[-1][1] - 2000: t = None   # the last turn belongs to an earlier prompt
    pend = pending(sid)
    if t is not None and t["status"] in DONE: state = t["status"]
    elif pend: state = "waiting_approval"
    elif t is not None and t["status"] == "running": state = "running"
    elif last is None: state = "starting"
    else: state = "running" if c.execute("select count(*) from part where session_id=? and time_created>?", (sid, users[-1][1])).fetchone()[0] else "starting"
    out = dict(task_id=sid, state=state, title=s["title"], directory=s["directory"], turns=len(users), archived=bool(s["time_archived"]))
    if t is not None:
        out.update(error=turn_error(c, sid, t["error_code"]) if t["status"] == "error" else None, cancelled_by_user=bool(t["cancelled_by_user"]), duration_ms=t["duration_ms"], tool_calls=t["tool_call_count"],
                   tokens=dict(input=t["input_tokens"], output=t["output_tokens"], reasoning=t["reasoning_tokens"], cache_read=t["cache_read_input_tokens"]))
    if pend: out["pending_approvals"] = pend
    return out


def parts(sid, since=0, cursor=None):
    """Changed parts in message/part order. Updated timestamps include edits to existing parts."""
    rows = conn(DBP).execute("""select p.id,p.sequence,p.data,coalesce(p.time_updated,p.time_created) updated,
        m.time_created mt,json_extract(m.data,'$.role') role from part p join message m on m.id=p.message_id
        where p.session_id=? and coalesce(p.time_updated,p.time_created)>=?
        and coalesce(json_extract(m.data,'$.metadata.visibility'),'')!='model-only'
        order by m.time_created,p.sequence,p.id""", (sid, since)).fetchall()
    if cursor is not None and rows:
        cursor["since"] = max(since, max(r["updated"] or 0 for r in rows) - 1000)
    return [(r["mt"], r["sequence"] or 0, r["id"], r["role"], json.loads(r["data"])) for r in rows]


def final_answer(sid):
    """Text of the last assistant message that has text (parts are not chronological by sequence across messages)."""
    last = None
    for mt, seq, pid, role, j in parts(sid):
        if role == "assistant" and j.get("type") == "text" and j.get("text", "").strip():
            if last is None or mt > last[0]: last = [mt, []]
            if mt == last[0]: last[1].append((seq, j["text"]))
    return "\n".join(t for _, t in sorted(last[1])) if last else None


def tool_calls(sid):
    res = []
    for mt, seq, pid, role, j in parts(sid):
        if j.get("type") == "tool":
            st = j.get("state") or {}
            res.append(dict(tool=j.get("tool"), status=st.get("status"), input=st.get("input")))
    return res


# ---------------------------------------------------------------- UI navigation
def need_app():
    zc("frontmost", check=False)
    try:
        zc("exists", "AXButton", "Send")  # raises not_running / no_window
    except BridgeError as e:
        if e.code != "no_window": raise
        # The window was closed (red button / Cmd+W) while ZCode keeps running: a reopen event makes it create the window again.
        # It brings ZCode to the front, which beats failing every task and every claim until someone opens the window by hand.
        before = frontmost()
        subprocess.run(["osascript", "-e", 'tell application id "%s" to reopen' % BUNDLE], capture_output=True, timeout=10)
        end = time.time() + 8
        while time.time() < end:
            time.sleep(0.5)
            try: zc("exists", "AXButton", "Send"); break
            except BridgeError as e2:
                if e2.code != "no_window": raise
        else:
            raise
        log("need_app: ZCode had no window; reopened it")
        if before and before != BUNDLE: subprocess.run(["open", "-b", before], capture_output=True, timeout=10)
    d = dump()
    if re.search(r"session has expired|Sign in again", d):
        raise BridgeError("session_expired", "ZCode shows 'session expired / Sign in again': the owner must sign in inside the app")
    return d


def to_workspace():
    state = composer_snapshot()
    if state.get("back"):
        press("AXButton", "=Back to workspace", wait=0)
        state = wait_snapshot(lambda s: s.get("workspace") and not s.get("back"))
    if not state.get("workspace"):
        zc("pressup", "AXStaticText", "=New task", check=False)
        wait_snapshot(lambda s: s.get("workspace"))


def close_stray_popups():
    """A menu left open by an interrupted run (e.g. 'Switch mode') swallows the next press; close it by pressing its trigger again."""
    for _ in range(3):
        m = re.search(r'AXMenu t="([^"]+)"', dump())
        if not m: return
        log("closing a stray open menu: %s" % m.group(1))
        zc("press", "AXPopUpButton", m.group(1), check=False); time.sleep(0.7)


def task_more():
    """Index of the task header's 'More' popup: sidebar project rows have one each, the header's comes last."""
    return max(0, int(zc("count", "AXPopUpButton", "=More", check=False).strip() or 1) - 1)


def clip_session_id():
    """Ask ZCode for the open task's id with its own 'Copy session ID' menu item; clipboard is restored."""
    old = subprocess.run(["pbpaste"], capture_output=True).stdout
    try:
        for attempt in range(3):
            subprocess.run(["pbcopy"], input=b"", check=True)
            press("AXPopUpButton", "=More", nth=task_more(), wait=1.0)
            try:
                wait_for("AXMenuItem", "Copy session ID", 3)
            except BridgeError:
                esc(("AXPopUpButton", "=More", task_more())); continue          # the first press can be eaten by a focused approval card
            # the page refuses to write the clipboard while ZCode is inactive: background does this one press inside a brief activation
            if FOREGROUND: zc("press", "AXMenuItem", "Copy session ID")
            else: zc("bgpress", "AXMenuItem", "Copy session ID", timeout=60)
            time.sleep(0.5)
            got = subprocess.run(["pbpaste"], capture_output=True).stdout.decode().strip()
            if got: return got
        raise BridgeError("ui_element_missing", "could not read the open task's session id")
    finally:
        subprocess.run(["pbcopy"], input=old)


def last_prompt(sid):
    c = conn(DBP); users = user_messages(c, sid)
    if not users: return None
    for (d,) in c.execute("select data from part where message_id=? order by sequence", (users[-1][0],)):
        j = json.loads(d)
        if j.get("type") == "text" and j.get("text", "").strip(): return j["text"].strip().splitlines()[0][:30]
    return None


def tag_in_title(title):
    return bool(re.match(r"\[bb:[0-9a-f]{6}\]", title or ""))


def verify_open(sid, s, rows=None):
    """Prove the open page is task `sid`. Foreground, or several tasks sharing the title: ZCode's own 'Copy session ID'.
    Background with a unique title: the heading matches and the page shows the task's last prompt (no clipboard, no focus change)."""
    if not FOREGROUND:
        tag = task_tag(sid)
        if tag:
            lines = dump().splitlines(); body = []
            for i, line in enumerate(lines):
                if line.strip() != "AXGroup id=conversation": continue
                indent = len(line) - len(line.lstrip())
                for child in lines[i + 1:]:
                    if child.strip() and len(child) - len(child.lstrip()) <= indent: break
                    body.append(child)
                break
            text = "\n".join(body)
            if tag in text:
                snip = last_prompt(sid)
                if snip is None or snip in text: return True
    same = conn(DBP).execute("select count(*) from session where title=? and parent_id is null", (s["title"],)).fetchone()[0]
    if FOREGROUND or same != 1: return clip_session_id() == sid
    snip = last_prompt(sid)
    return exists("AXHeading", "=" + s["title"]) and (snip is None or snip in dump())


def task_tag(sid):
    m = re.match(r"\[bb:([0-9a-f]{6})\]", first_user_text(sid))
    return "[bb:%s]" % m.group(1) if m else None


def open_task(sid):
    """Select the task in the sidebar and prove it is the right one. A task `send` started carries a unique [bb:xxxxxx] tag at the start
    of its first prompt and so of its title: it is looked up by the tag (tasks started by hand or by older versions: by title, proved
    with ZCode's own 'Copy session ID')."""
    s = session_row(sid); tag = task_tag(sid) if tag_in_title(s["title"]) else None
    title = tag or re.sub(r"\.\.\.$", "", s["title"]).strip()[:40]
    need_app(); to_workspace()
    n = zc("count", "AXStaticText", title, check=False).strip()
    if n in ("", "0") and exists("AXButton", "=Show more"):
        press("AXButton", "=Show more", wait=0.8); n = zc("count", "AXStaticText", title, check=False).strip()
    if exists("AXHeading", "=" + s["title"]) and verify_open(sid, s): return
    for i in range(int(n or 0)):
        r = zc("pressup", "AXStaticText", title, nth=i, check=False)
        if r.startswith("ERR"): continue
        time.sleep(1.2)
        if verify_open(sid, s): return
    raise BridgeError("task_not_in_sidebar", "could not open task %s (title %r) in the sidebar" % (sid, s["title"]))


def composer_model():
    """(model label, effort label) from the composer's model chip, e.g. 'GLM-5.3-Flash High' -> ('GLM-5.3-Flash', 'High'); None if unreadable."""
    for l in zc("find", "AXPopUpButton", "", check=False).splitlines():
        t = first(l); m = re.match(r"^(.*?)\s+(Low|High|Max)$", t)
        if m and "Switch mode" not in l: return m.group(1), m.group(2)
    return None


def set_model(model, effort, _again=False):
    return configure_composer(model, effort)[2]




PLAN_CHIP = "Remove Plan from the next submission"


def plan_on():
    """ZCode shows a 'Plan' chip in the composer only while Plan mode is ON (its remove button is the AX element); chip present = Plan on."""
    return exists("AXButton", PLAN_CHIP)


def set_mode(mode):
    base = MODES["ask"] if mode == "plan" else MODES[mode]
    state = composer_snapshot(); changed = False
    if state.get("plan") and mode != "plan":
        press("AXButton", "=" + PLAN_CHIP, allow=True, wait=0)
        state = wait_snapshot(lambda s: not s.get("plan")); changed = True
    if state.get("mode") == base and state.get("plan") == (mode == "plan"): return changed
    for name in ([base] if state.get("mode") != base else []) + (["Plan mode"] if mode == "plan" and not state.get("plan") else []):
        press("AXPopUpButton", "=Switch mode", wait=0)
        def item(s): return next((i for i in s.get("menu_items", []) if i["name"].startswith(name)), None)
        state = wait_snapshot(lambda s: item(s) is not None)
        press("AXMenuItem", "=" + item(state)["name"], allow=True, wait=0)
        if name == "Plan mode": state = wait_snapshot(lambda s: s.get("plan"))
        else: state = wait_snapshot(lambda s: s.get("mode") == base)
        if state.get("menu_open"): esc(("AXPopUpButton", "=Switch mode"))
        changed = True
    wait_snapshot(lambda s: s.get("mode") == base and s.get("plan") == (mode == "plan"))
    return changed


def current_mode(d=None):
    m = re.search(r'd="Switch mode"[^\n]*\n(?:[^\n]*\n)*?\s*AXStaticText v="([^"]+)"', d if d is not None else dump())
    return m.group(1) if m else None


def project_new_task_index(name, d):
    """Index (among all 'New task' buttons of the tree) of the New task button in the sidebar row of project `name`."""
    n = -1; seen = False
    for l in d.splitlines():
        if re.search(r'AXButton t="%s"$' % re.escape(name), l.rstrip()): seen = True
        if 'AXButton d="New task"' in l:
            n += 1
            if seen: return n
    return None


def open_project_new_task(p):
    """The project's own 'New task' button in the sidebar opens the New task page with that project already chosen: no project menu is
    opened. Returns True when the page shows the project selection chip."""
    d = dump(120); i = project_new_task_index(p["name"], d)
    if i is None: return False
    zc("press", "AXButton", "=New task", nth=i, check=False)
    try: wait_snapshot(lambda s: s.get("new_task") and s.get("project_selected") and s.get("model"), timeout=6)
    except BridgeError: return False
    return True


def choose_workspace(folder):
    """Pick the target project and wait for its composer after the menu has closed."""
    if folder is None:
        p = None; label = "Work outside a project"
    else:
        p = find_project(folder)
        CREATED["project"] = False
        if p is None:
            p = create_project(folder); CREATED["project"] = True
            to_workspace()
        if not composer_snapshot().get("new_task") and open_project_new_task(p): return p
        label = p["name"]
    if not composer_snapshot().get("new_task"):
        zc("pressup", "AXStaticText", "=New task", check=False)
        wait_snapshot(lambda s: s.get("new_task") and s.get("model"))
    press("AXPopUpButton", "=Choose workspace", wait=0)
    def selected(s): return next((i for i in s.get("menu_items", []) if i["name"] == label), None)
    state = wait_snapshot(lambda s: selected(s) is not None)
    press("AXMenuItem", "=" + label, wait=0)
    wait_snapshot(lambda s: not s.get("menu_open") and s.get("workspace") and s.get("model"))
    return p


def open_via_deeplink(real):
    """Register a folder as a ZCode project the way ZCode itself supports from outside: its zcode://workspace/open URL. ZCode answers
    with its own confirmation sheet ("Open this folder in ZCode?", buttons Cancel / Open folder) that names the folder; that one button
    is pressed through accessibility (no keystrokes, no folder panel, any characters in the path). Caller holds the UI lock."""
    import urllib.parse
    url = "zcode://workspace/open?path=" + urllib.parse.quote(real, safe="")
    subprocess.run(["open", "-g", url], timeout=15, check=False)
    end = time.time() + 12
    while time.time() < end:
        d = dump(40)
        m = re.search(r'AXSheet d="alert"[\s\S]*', d)
        if m and 'AXButton t="Open folder"' in m.group(0):
            if real not in m.group(0).replace("\\n", "\n") and os.path.basename(real) not in m.group(0):
                raise BridgeError("deeplink_other_folder", "ZCode's confirmation sheet names a different folder; not confirming")
            zc("press", "AXButton", "=Open folder"); break
        time.sleep(0.4)
    else:
        raise BridgeError("deeplink_no_sheet", "ZCode showed no confirmation sheet for %s" % real)
    for _ in range(25):
        if find_project(real, enclosing=False): return find_project(real, enclosing=False)
        time.sleep(0.5)
    raise BridgeError("project_not_created", "ZCode did not register %s after the confirmation" % real)


def create_project(folder):
    """Background: ZCode's own open-folder link (open_via_deeplink). Foreground fallback: New task -> project picker -> Create
    project -> folder panel (Cmd+Shift+G + an ASCII symlink) -> Trust folders and create."""
    real = os.path.realpath(folder)
    if not os.path.isdir(real): raise BridgeError("bad_folder", "%s is not a directory" % folder)
    if not FOREGROUND:
        try: return open_via_deeplink(real)
        except BridgeError as e:
            if e.code not in ("deeplink_no_sheet", "project_not_created"): raise
            raise BridgeError("foreground_required", "ZCode did not take the folder through its open-folder link (%s); run `zcbridge project-add %s --foreground` once" % (e, folder))
    name = os.path.basename(real); links = os.path.join(STATE, "links"); os.makedirs(links, exist_ok=True)
    link = os.path.join(links, hashlib.sha1(real.encode()).hexdigest()[:10])
    if os.path.islink(link): os.unlink(link)
    os.symlink(real, link)
    to_workspace(); guard(); zc("pressup", "AXStaticText", "=New task", check=False); time.sleep(1.0)
    press("AXPopUpButton", "Choose workspace"); pick_menu("Create project", exact=False); time.sleep(1)
    guard(); zc("setvalue", "AXTextField", "", name); press("AXButton", "Choose folder"); time.sleep(1.5)
    keys('keystroke "g" using {command down, shift down}'); time.sleep(0.8)
    keys('keystroke "a" using {command down}'); keys('keystroke "%s"' % link); time.sleep(1)
    keys("key code 36"); time.sleep(1.5); keys("key code 36"); time.sleep(1.5)
    press("AXButton", "Create project", wait=1.5)
    press("AXButton", "Trust folders and create", allow=True, wait=3)   # ZCode's own workspace-trust dialog for the folder the caller named
    p = find_project(folder)
    if not p: raise BridgeError("project_not_created", "project was not created for %s" % folder)
    return p


def composer_text():
    for l in dump().splitlines():
        if "AXTextArea" in l and "FOCUSED" in l: return l
    return None


def sessions():
    """Ids of top-level tasks (a running task's subagent sessions have a parent_id and are not tasks of ours)."""
    return {r[0] for r in conn(DBP).execute("select id from session where parent_id is null")}


# ---------------------------------------------------------------- parallel limit (counting lock over running tasks)
SLOTS = os.path.join(STATE, "slots.json")
SLOT_MAX_AGE = 6 * 3600     # a slot whose task is still "running" after this long is considered stuck and freed


def config_value(key, default=None):
    try: v = json.load(open(os.path.join(STATE, "config.json"))).get(key)
    except Exception: v = None
    return default if v is None else v


def default_mode():
    """Mode of a task when the caller names none: ~/.zcode-bridge/config.json "default_mode" (ask|plan|auto|full), else ask."""
    v = config_value("default_mode", "ask")
    return v if v in MODES else "ask"


def max_parallel():
    v = os.environ.get("ZCODE_MAX_PARALLEL")
    if v is None:
        try: v = json.load(open(os.path.join(STATE, "config.json"))).get("max_parallel")
        except Exception: v = None
    try: return max(0, int(v)) if v is not None else 3
    except (TypeError, ValueError): return 3


@contextlib.contextmanager
def slots_flock():
    os.makedirs(STATE, exist_ok=True)
    f = open(os.path.join(STATE, "slots.lock"), "w"); fcntl.flock(f, fcntl.LOCK_EX)
    try: yield
    finally: fcntl.flock(f, fcntl.LOCK_UN); f.close()


def pid_alive(pid):
    try: os.kill(pid, 0); return True
    except PermissionError: return True
    except Exception: return False


def slots_live():
    """Slots still held: a task that has not reached completed/error/cancelled, or a starter (no task id yet) whose process is alive."""
    try: es = json.load(open(SLOTS))
    except Exception: es = []
    keep = []
    for e in es:
        age = time.time() - e.get("at", 0)
        if e.get("owner_pid") and not pid_alive(e["owner_pid"]): continue   # its zcode-acp is gone (BB side failed or stopped): the slot is free
        if e.get("task_id"):
            try: live = task_state(e["task_id"])["state"] not in DONE
            except BridgeError: live = False
            if live and age < SLOT_MAX_AGE: keep.append(e)
        elif pid_alive(e.get("pid", 0)) and age < 600: keep.append(e)
    return keep


def slots_save(es):
    os.makedirs(STATE, exist_ok=True); tmp = SLOTS + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as f: json.dump(es, f)
    os.replace(tmp, SLOTS)


def slot_acquire(wait_s, label):
    """Take one of ZCODE_MAX_PARALLEL slots, waiting up to wait_s seconds for a running task to finish (0 = fail at once)."""
    end = time.time() + wait_s; tok = uuid.uuid4().hex; told = False
    while True:
        n = max_parallel()
        with slots_flock():
            es = slots_live()
            if not n or len(es) < n:
                es.append(dict(token=tok, pid=os.getpid(), owner_pid=int(os.environ.get("ZCBRIDGE_OWNER_PID") or 0) or None, at=time.time(), label=label, task_id=None)); slots_save(es); return tok
            held = [e.get("task_id") or e.get("label") for e in es]
            slots_save(es)
        if time.time() >= end:
            raise BridgeError("parallel_limit", "%d of %d ZCode tasks are running (%s); a slot frees when one finishes (limit: ZCODE_MAX_PARALLEL)" % (len(held), n, ", ".join(map(str, held))), running=len(held), limit=n)
        if not told: log("%s waits for a slot (%d/%d held)" % (label, len(held), n)); told = True
        time.sleep(min(2.0, max(0.2, end - time.time())))


def slot_update(tok, **kw):
    with slots_flock():
        es = json.load(open(SLOTS)) if os.path.exists(SLOTS) else []
        for e in es:
            if e.get("token") == tok: e.update(kw)
        slots_save(es)


def slot_release(tok):
    with slots_flock():
        try: es = json.load(open(SLOTS))
        except Exception: es = []
        slots_save([e for e in es if e.get("token") != tok])


def do_slots(a):
    with slots_flock():
        es = slots_live(); slots_save(es)
    return dict(ok=True, limit=max_parallel(), held=len(es), slots=[dict(task_id=e.get("task_id"), label=e.get("label"), age_s=int(time.time() - e["at"])) for e in es])


def submit(prompt):
    """Paste the prompt into the focused composer and press Send. Caller has verified the target screen."""
    guard()
    line = composer_text()
    if line is None and not FOREGROUND: line = next((l for l in dump().splitlines() if "AXTextArea" in l), None)   # background: AXFocused alone is not reported while the app is inactive
    if line is None: raise BridgeError("composer_not_focused", "composer is not focused")
    if not re.search(r'v="\\n"', line): raise BridgeError("composer_not_empty", "composer already has text")
    if not paste(prompt):
        raise BridgeError("prompt_not_pasted", "prompt text did not reach the composer")
    for _ in range(12):   # Send stays disabled until the page has registered the pasted text
        if "[disabled]" not in zc("find", "AXButton", "=Send", check=False): break
        time.sleep(0.4)
    press("AXButton", "=Send", wait=0)
    state = wait_snapshot(lambda s: s.get("promo_offer") or s.get("composer_empty"))
    if state.get("promo_offer"):
        press("AXButton", "=Not now", wait=0)
        wait_snapshot(lambda s: not s.get("promo_offer") and s.get("composer_empty"))


def check_mode_policy(a):
    if getattr(a, "mode_from_config", False): return    # the owner's own configured default needs no flag
    if a.mode == "auto" and not a.allow_autonomous:
        raise BridgeError("policy", "--mode auto needs --allow-autonomous (the agent then edits and runs commands without asking)")
    if a.mode == "full" and not a.allow_full:
        raise BridgeError("policy", "--mode full needs --allow-full (the agent then edits and runs commands without asking and without limits)")


def do_send(a):
    tag = uuid.uuid4().hex[:6]
    if not a.mode: a.mode = default_mode(); a.mode_from_config = True
    prompt = read_prompt(a)
    check_mode_policy(a)
    if a.folder and not os.path.isdir(a.folder): raise BridgeError("bad_folder", "%s is not a directory" % a.folder)
    if a.folder and a.no_create_project and not find_project(a.folder):
        raise BridgeError("project_missing", "%s is not a ZCode project and automatic creation is off (project-add %s)" % (a.folder, a.folder))
    T = {"t0": time.time()}
    tok = slot_acquire(a.queue_timeout, "send")   # wait for a free slot BEFORE touching the window or its lock
    T["slot"] = time.time(); bound = False
    try:
        with ui_lock() as prev:   # the lock covers only the window-driving steps, up to the Send press
            T["lock"] = time.time()
            need_app(); guard(); close_stray_popups(); to_workspace()
            before = sessions()
            proj = choose_workspace(a.folder and os.path.abspath(a.folder))
            route, route_note = choose_route(a.route, a.model, tok, effort=a.effort)
            set_mode(a.mode)
            T["setup"] = time.time()
            zc("focus", "AXTextArea", "", check=False)
            if a.folder and proj:   # the folder lies inside a bigger project (its git repository): say where to work
                real = os.path.realpath(a.folder); root = next((r for r in (os.path.realpath(x) for x in proj["roots"]) if real != r and real.startswith(r + os.sep)), None)
                if root: prompt = "(Work inside the subfolder %s of this project; the project root is %s.)\n\n%s" % (os.path.relpath(real, root), root, prompt)
            if not getattr(a, "no_tag", False): prompt = "[bb:%s] %s" % (tag, prompt)
            submit(prompt)
            T["sent"] = time.time()
        roots = {os.path.realpath(r) for r in (proj or {}).get("roots", [])} or ({os.path.realpath(a.folder)} if a.folder else None)
        sid = wait_new_session(before, roots, prompt)
        T["session"] = time.time()
        slot_update(tok, task_id=sid, at=time.time()); bound = True
    finally:
        if not bound: slot_release(tok)
    res = dict(ok=True, task_id=sid, route=route, project=proj and proj["name"], project_created=bool(CREATED.get("project")), model=MODELS.get(a.model, a.model), effort=a.effort or "default", mode=a.mode,
               timings_ms=dict(slot_wait=int((T["slot"] - T["t0"]) * 1000), lock_wait=int((T["lock"] - T["slot"]) * 1000), ui_pick_project_model_mode=int((T["setup"] - T["lock"]) * 1000),
                               ui_paste_and_send=int((T["sent"] - T["setup"]) * 1000), lock_held=int((T["sent"] - T["lock"]) * 1000), session_in_db=int((T["session"] - T["sent"]) * 1000)))
    if route_note: res["route_note"] = route_note
    log("send %s route %s menus_opened %d%s timings %s" % (sid, route, len(TRACE), [t["control"] for t in TRACE], res["timings_ms"]))
    if a.wait: res.update(wait_task(sid, a.timeout, a.approve, a.poll))
    return res


def first_user_text(sid):
    c = conn(DBP); users = user_messages(c, sid)
    if not users: return ""
    for (d,) in c.execute("select data from part where message_id=? order by sequence", (users[0][0],)):
        j = json.loads(d)
        if j.get("type") == "text" and j.get("text", "").strip(): return j["text"].strip()
    return ""


def wait_new_session(before, folder=None, prompt=None):
    """The session this send created: new top-level, in the folder asked for, and (when other sends started meanwhile) the one
    whose first message is our prompt. Other bridge processes may start tasks while we look, so the newest id is not enough."""
    want = " ".join((prompt or "").split())[:60]
    for _ in range(400):
        new = sessions() - before
        if folder and new:
            c = conn(DBP); new = {i for i in new if os.path.realpath(c.execute("select directory from session where id=?", (i,)).fetchone()[0] or "") in folder}
        if new and want:
            new = {i for i in new if " ".join(first_user_text(i).split())[:60] == want}
        if new:
            c = conn(DBP); return sorted(new, key=lambda i: c.execute("select time_created from session where id=?", (i,)).fetchone()[0])[0]
        time.sleep(0.1)
    raise BridgeError("no_new_session", "Send was pressed but no new session appeared in ZCode's db")


def do_mode_reset(a):
    """Put ZCode's composer back on the owner's resting mode (--to, default full = Full access; never Plan) with Plan off (the Plan chip
    gone), and on --model when given, after a session ran in another mode or model: with --task that task's own page, without it the
    New task composer. ZCode has no settings entry for a default mode or model; what it starts a new task with is what the composer
    was last left on. Changes nothing that already reads right."""
    with ui_lock():
        need_app(); close_stray_popups(); to_workspace()
        if a.task: open_task(a.task)
        else:
            zc("pressup", "AXStaticText", "=New task", check=False); wait_for("AXTextArea", ""); time.sleep(0.6)
        changed = set_mode(a.to) if a.to != "none" else False
        if a.model: changed = bool(set_model(a.model, a.effort)) or changed
    return dict(ok=True, mode=a.to, plan=False, changed=changed, model=a.model, scope="task" if a.task else "new-task")


def do_continue(a):
    if not a.mode and "default_mode" in (json.load(open(os.path.join(STATE, "config.json"))) if os.path.exists(os.path.join(STATE, "config.json")) else {}):
        a.mode = default_mode(); a.mode_from_config = True
    if a.mode: check_mode_policy(a)
    prompt = read_prompt(a)
    st = task_state(a.task)
    if st["state"] not in DONE and not a.force:
        raise BridgeError("task_busy", "task is %s; wait for it or pass --force to queue the follow-up (ZCode setting 'Interaction behavior: Queue')" % st["state"])
    n0 = st["turns"]
    T = {"t0": time.monotonic()}
    tok = slot_acquire(a.queue_timeout, "continue " + a.task)
    T["slot"] = time.monotonic()
    bound = False
    try:
        with ui_lock():
            T["lock"] = time.monotonic()
            open_task(a.task); guard()
            if a.mode: set_mode(a.mode)
            T["setup"] = time.monotonic()
            zc("focus", "AXTextArea", "", check=False)
            submit(prompt)
            T["sent"] = time.monotonic()
        for _ in range(300):   # the new user turn shows in the db a moment after Send; no UI lock needed to see it
            if task_state(a.task)["turns"] > n0: break
            time.sleep(0.1)
        else: raise BridgeError("no_new_turn", "Send was pressed but the task shows no new user turn")
        slot_update(tok, task_id=a.task, at=time.time()); bound = True
    finally:
        if not bound: slot_release(tok)
    res = dict(ok=True, task_id=a.task, turn=n0 + 1, timings_ms=dict(slot_wait=int((T["slot"]-T["t0"])*1000), lock_wait=int((T["lock"]-T["slot"])*1000), ui_open_and_mode=int((T["setup"]-T["lock"])*1000), ui_paste_and_send=int((T["sent"]-T["setup"])*1000), lock_held=int((T["sent"]-T["lock"])*1000)))
    log("continue %s menus_opened %d timings %s" % (a.task, len(TRACE), res["timings_ms"]))
    if a.wait: res.update(wait_task(a.task, a.timeout, a.approve, a.poll))
    return res


# ---------------------------------------------------------------- approvals
APPROVE_TOOLS = {"Write", "Edit", "MultiEdit", "ApplyPatch", "NotebookEdit"}


def call_paths(item):
    inp = item.get("input") or {}
    ps = [inp[k] for k in ("file_path", "path", "notebook_path", "filePath") if isinstance(inp.get(k), str)]
    for k in ("patch", "input", "diff"):
        if isinstance(inp.get(k), str): ps += re.findall(r"^\*\*\* (?:Add|Update|Delete) File: (.+)$", inp[k], re.M)
    return ps


def decide(item, project_dir, policy):
    """Return ('allow'|'deny'|'hold', reason). Default is deny; only in-project file edits are ever auto-approved."""
    if policy == "manual": return "hold", "manual policy"
    if policy == "deny": return "deny", "policy deny"
    if policy == "project":
        if item["tool"] not in APPROVE_TOOLS: return "deny", "tool %s is not an in-project file edit" % item["tool"]
        ps = call_paths(item)
        if not ps: return "deny", "no target path in the call"
        root = os.path.realpath(project_dir)
        for p in ps:
            rp = os.path.realpath(p if os.path.isabs(p) else os.path.join(root, p))
            if rp != root and not rp.startswith(root + os.sep): return "deny", "path outside the project: %s" % p
        return "allow", "in-project edit"
    raise BridgeError("bad_policy", "unknown approve policy %r (deny|project|manual)" % policy)


def answer_card(choice, wait=1.0):
    """Press 'Allow' (once) or 'Deny' on the open permission card. Never 'Always allow' / 'Full access'."""
    lab = {"allow": "=Allow", "deny": "=Deny"}[choice]
    wait_for("AXList", "Permission required", 6)
    press("AXMenuItem", lab, wait=wait)
    if exists("AXButton", "=Confirm"): press("AXButton", "=Confirm", wait=wait)   # Deny keeps a feedback box; Allow confirms on press


def handle_approvals(sid, policy, project_dir=None):
    log_ = []
    s = session_row(sid); project_dir = project_dir or s["directory"]
    for _ in range(12):
        pend = pending(sid)
        if not pend: break
        item = pend[0]; verdict, why = decide(item, project_dir, policy)
        entry = dict(call_id=item["call_id"], tool=item["tool"], paths=call_paths(item), verdict=verdict, reason=why)
        log_.append(entry)
        if verdict == "hold": break
        with ui_lock():
            open_task(sid); answer_card(verdict)
        for _ in range(10):
            if not any(p["call_id"] == item["call_id"] for p in pending(sid)): break
            time.sleep(0.8)
        else: entry["warning"] = "card still pending after the press"; break
    return log_


# ---------------------------------------------------------------- waiting / results
def wait_task(sid, timeout, policy="deny", poll=2.0):
    end = time.time() + timeout; acts = []
    while True:
        st = task_state(sid)
        if st["state"] in DONE or (st["state"] == "waiting_approval" and policy == "manual"): break
        if st["state"] == "waiting_approval":
            got = handle_approvals(sid, policy); acts += got
            if not got or got[-1]["verdict"] == "hold": break
        if time.time() > end:
            st["timed_out"] = True; break
        time.sleep(poll)
    st = task_state(sid)
    out = dict(state=st["state"], answer=final_answer(sid) if st["state"] in DONE else None, usage=st.get("tokens"), duration_ms=st.get("duration_ms"), tool_calls=st.get("tool_calls"))
    if st.get("error"): out["error"] = st["error"]
    if acts: out["approvals"] = acts
    if st["state"] == "waiting_approval": out["pending_approvals"] = st.get("pending_approvals")
    if time.time() > end and st["state"] not in DONE: out["timed_out"] = True
    return out


STOP_LABELS = ("=Stop", "Stop generating", "Stop", "Interrupt")


def do_cancel(a):
    """Interrupt a turn, fast. The task is usually still open from the send/continue that started it, so there is no navigation:
    Stop is pressed through accessibility at once (a pending permission card is denied first, because Stop alone leaves the card
    requested in the db); the db is then polled every 0.3 s until ZCode records the turn as cancelled."""
    t0 = time.time()
    st = task_state(a.task)
    if st["state"] in DONE: return dict(ok=True, task_id=a.task, state=st["state"], note="already finished")
    how = None
    with ui_lock():
        open_task(a.task)   # returns at once when the right task is already on screen
        find_stop = lambda: next((q for q in STOP_LABELS if exists("AXButton", q)), None)
        stop = find_stop()
        if stop and st["state"] != "waiting_approval":
            press("AXButton", stop, wait=0.2); how = "stop-button:" + stop
        elif not FOREGROUND:
            # background: no Escape key. Deny the card, then press Stop at once if the model is still going (it often answers within a second)
            answer_card("deny", wait=0.35); how = "deny-card"
            for _ in range(8):
                stop = find_stop()
                if stop: press("AXButton", stop, wait=0.2); how += "+stop-button"; break
                if task_state(a.task)["state"] in DONE: break
                time.sleep(0.2)
        else:
            guard(); keys("key code 53"); time.sleep(1.5); how = "escape"
    for _ in range(60):
        st = task_state(a.task)
        if st["state"] in DONE: break
        time.sleep(0.3)
    return dict(ok=st["state"] == "cancelled", task_id=a.task, state=st["state"], cancelled_by_user=st.get("cancelled_by_user"), how=how, took_ms=int((time.time() - t0) * 1000))


def do_archive(a):
    """Archive (hide) a task through its own More menu. Reversible in ZCode's Archive management; the db row is kept."""
    with ui_lock():
        open_task(a.task)
        press("AXPopUpButton", "=More", nth=task_more(), wait=1.0); wait_for("AXMenuItem", "Archive task", 4)
        press("AXMenuItem", "Archive task", wait=1.5)
        if exists("AXButton", "Archive task"): press("AXButton", "Archive task", wait=1.5)   # ZCode's own confirm dialog
    for _ in range(10):
        r = conn(IDXP).execute("select archived from tasks where task_id=?", (a.task,)).fetchone()
        if r and r[0]: return dict(ok=True, task_id=a.task, archived=True)
        time.sleep(0.8)
    raise BridgeError("not_archived", "Archive task was pressed but the task is not archived")


# ---------------------------------------------------------------- usage / quota
def do_usage(a):
    c = conn(DBP); out = {}
    q = "select date(started_at/1000,'unixepoch','localtime') d, count(*) turns, sum(input_tokens) i, sum(output_tokens) o, sum(cache_read_input_tokens) cr, sum(tool_call_count) tools from turn_usage %s group by d order by d desc limit ?"
    out["by_day"] = [dict(r) for r in c.execute(q % "", (a.days,))]
    out["by_model"] = [dict(r) for r in c.execute("select provider_id, model_id, status, count(*) requests, sum(input_tokens) i, sum(output_tokens) o from model_usage group by 1,2,3")]
    out["by_provider_day"] = [dict(r, fresh_input=(r["input"] or 0) - (r["cache_read"] or 0)) for r in c.execute(
        "select date(started_at/1000,'unixepoch','localtime') day, provider_id, model_id, count(*) requests, sum(input_tokens) input, sum(cache_read_input_tokens) cache_read, "
        "sum(output_tokens) output from model_usage where status!='running' and started_at >= ? group by 1,2,3 order by 1 desc, 2, 3",
        (int((time.time() - a.days * 86400) * 1000),))]
    out["tasks"] = c.execute("select count(*) from session where parent_id is null").fetchone()[0]
    if a.quota: out["quota"] = read_quota()
    return dict(ok=True, **out)


def read_quota_page():
    """Background: the same numbers from Settings > Model settings > 'Quota remaining' (a static page; the composer popover opens only
    while ZCode is active). Reset buttons are never pressed."""
    with ui_lock():
        need_app(); to_workspace()
        press("AXButton", "=Settings", wait=1.5); press("AXButton", "=Model settings", wait=1.5)
        try:
            d = dump()
        finally:
            if exists("AXButton", "=Back to workspace"): press("AXButton", "=Back to workspace", wait=1.0)
    lines = [l.split('v="', 1)[1].rsplit('"', 1)[0] for l in d.splitlines() if "AXStaticText" in l and 'v="' in l]
    if "Quota remaining" not in lines: raise BridgeError("quota_unreadable", "quota section not found in Model settings")
    seg = lines[lines.index("Quota remaining") + 1:lines.index("Model list")] if "Model list" in lines else lines[lines.index("Quota remaining") + 1:]
    q = {}; cur = None
    for v in seg:
        if re.fullmatch(r"\d+%", v) and cur: q[cur]["remaining"] = v
        elif cur and "remaining" in q[cur] and "resets" not in q[cur]: q[cur]["resets"] = v
        else: cur = re.sub(r" remaining$", "", v); q[cur] = {}
    return q


def read_quota():
    """Read the 'Usage remaining' popover of the New task composer (numbers ZCode itself shows; no network call from us)."""
    if not FOREGROUND: return read_quota_page()
    with ui_lock():
        need_app(); guard(); to_workspace()
        zc("pressup", "AXStaticText", "=New task", check=False); wait_for("AXButton", "Usage remaining")
        press("AXButton", "Usage remaining", wait=1.2)
        lines = [l.split("v=\"", 1)[1].rsplit("\"", 1)[0] for l in dump().splitlines() if "AXStaticText" in l and 'v="' in l]
        esc(("AXButton", "Usage remaining"))
    if "Usage remaining" not in lines: raise BridgeError("quota_unreadable", "quota popover not found")
    seg = lines[lines.index("Usage remaining") + 1:]; q = {}; cur = None
    for v in seg:
        if re.fullmatch(r"\d+%", v) and cur: q[cur]["remaining"] = v
        elif v.strip() in ("·", "") or v == " · ": continue
        elif cur and "remaining" in q[cur] and "resets" not in q[cur] and not re.fullmatch(r"\d+%", v): q[cur]["resets"] = v
        else:
            cur = v; q[cur] = {}
    return q


# ---------------------------------------------------------------- automations (UI)
SCHEDULES = {"hour": "Every hour", "day": "Every day", "weekday": "Every weekday", "week": "Every week", "month": "Every month"}


def to_automations():
    need_app(); guard()
    if exists("AXButton", "=Back to workspace"): press("AXButton", "=Back to workspace", wait=1.2)
    if "value=1" not in zc("attrs", "AXCheckBox", "=Automations", check=False): press("AXCheckBox", "=Automations", wait=1.2)
    if exists("AXButton", "=Automations") and not exists("AXRadioButton", "=Automations"):   # breadcrumb of a form/detail page
        press("AXButton", "=Automations", wait=1.0)
        if exists("AXButton", "=Discard"): press("AXButton", "=Discard", allow=True, wait=1.0)
    if exists("AXRadioButton", "=Automations"): press("AXRadioButton", "=Automations", wait=1.0)
    wait_for("AXButton", "Create scheduled task", 6)


def automation_row(aid):
    c = conn(IDXP); r = c.execute("select title,prompt from automations where automation_id=?", (aid,)).fetchone()
    if not r: raise BridgeError("no_such_automation", "no automation %s" % aid)
    rows = [first(l) for l in zc("find", "AXButton", "", check=False).splitlines() if "More actions" in l or re.search(r"Ran \d+ times?", l)]
    for i, lab in enumerate(rows):
        if lab.startswith(r["title"]) and r["prompt"][:30] in lab: return i
    raise BridgeError("automation_not_listed", "automation %s is not in the Automations list (rows: %d)" % (aid, len(rows)))


def automation_menu(aid, item, allow=False):
    i = automation_row(aid)
    press("AXPopUpButton", "More actions", nth=i, wait=1.0)
    wait_for("AXMenuItem", item, 4)
    press("AXMenuItem", item, allow=allow, wait=1.0)


def automation_state(aid):
    r = conn(IDXP).execute("select enabled,lifecycle_status,next_run_at,run_count,running from automations where automation_id=?", (aid,)).fetchone()
    return None if r is None else dict(enabled=bool(r[0]), status=r[1], next_run_at=r[2], runs=r[3], running=bool(r[4]))


def do_auto_create(a):
    if a.schedule not in SCHEDULES: raise BridgeError("bad_schedule", "schedule must be one of %s" % list(SCHEDULES))
    prompt = read_prompt(a); before = {r[0] for r in conn(IDXP).execute("select automation_id from automations")}
    proj = find_project(a.folder) if a.folder else None
    if a.folder and not proj: raise BridgeError("unknown_project", "open %s once with `zcbridge send --folder` so ZCode has the project" % a.folder)
    with ui_lock():
        to_automations(); press("AXButton", "=Create scheduled task", wait=1.2)
        wait_for("AXTextField", "Task title", 6)
        zc("setvalue", "AXTextField", "Task title", a.title); time.sleep(0.4)
        press("AXPopUpButton", "Add schedule", wait=0.9); pick_menu(SCHEDULES[a.schedule]); time.sleep(0.8)
        zc("focus", "AXTextArea", "Instructions"); time.sleep(0.4)
        if not paste(prompt, target=("AXTextArea", "Instructions")): raise BridgeError("prompt_not_pasted", "instructions did not reach the form")
        if proj:
            cur = next((first(l) for l in zc("find", "AXComboBox", "", check=False).splitlines() if first(l) in [p["name"] for p in projects()]), None)
            if cur != proj["name"]:
                press("AXComboBox", cur, wait=0.9); pick_menu(proj["name"])
        lab = MODELS.get(a.model, a.model)
        press("AXPopUpButton", "Choose model", wait=0.9); pick_menu(lab, exact=False); time.sleep(0.6)
        if a.effort:
            cur = next((first(l) for l in zc("find", "AXComboBox", "", check=False).splitlines() if first(l) in ("Low", "High", "Max")), None)
            if cur and cur.lower() != a.effort:
                press("AXComboBox", "=" + cur, wait=0.9); pick_menu(a.effort.capitalize())
        if "Ask before changes" not in zc("find", "AXComboBox", "Switch mode", check=False):
            raise BridgeError("mode_not_set", "automation form is not in 'Ask before changes'")
        press("AXButton", "=Create scheduled task", wait=2.0)
        for _ in range(10):
            new = {r[0] for r in conn(IDXP).execute("select automation_id from automations")} - before
            if new: break
            time.sleep(1)
        else: raise BridgeError("automation_not_created", "Create was pressed but no automation row appeared")
    aid = new.pop()
    return dict(ok=True, automation_id=aid, **automation_state(aid))


def do_auto_run(a):
    c = conn(IDXP); n0 = c.execute("select count(*) from automation_runs where automation_id=?", (a.id,)).fetchone()[0]
    with ui_lock():
        to_automations(); automation_menu(a.id, "Run now")
    sid = None
    for _ in range(60):
        r = conn(IDXP).execute("select run_id,session_id,dispatch_status,outcome from automation_runs where automation_id=? order by created_at desc limit 1", (a.id,)).fetchone()
        if r and conn(IDXP).execute("select count(*) from automation_runs where automation_id=?", (a.id,)).fetchone()[0] > n0 and r[1]:
            sid = r[1]; break
        time.sleep(1)
    if not sid: raise BridgeError("no_run", "Run now was pressed but no run with a session appeared")
    res = dict(ok=True, automation_id=a.id, task_id=sid)
    if a.wait: res.update(wait_task(sid, a.timeout, a.approve, 2.0))
    return res


def do_auto_toggle(a, item):
    with ui_lock():
        to_automations(); automation_menu(a.id, item)
    time.sleep(1.0)
    return dict(ok=True, automation_id=a.id, **(automation_state(a.id) or {}))


def do_auto_delete(a):
    with ui_lock():
        to_automations(); automation_menu(a.id, "Delete", allow=True)
        wait_for("AXButton", "Delete", 4)
        dlg = [l for l in dump().splitlines() if "AXApplicationDialog" in l]
        if not dlg: raise BridgeError("ui_element_missing", "no delete confirmation dialog")
        zc("press", "AXButton", "=Delete", nth=int(zc("count", "AXButton", "=Delete").strip() or 1) - 1); time.sleep(1.2)
    return dict(ok=True, automation_id=a.id, deleted=automation_state(a.id) is None)


# ---------------------------------------------------------------- rewards (daily claimable token banner)
REWARDS_FILE = os.path.join(STATE, "rewards.json")


def sidebar_banner_buttons(d):
    """Buttons ZCode shows between the Tasks list and the account button of the sidebar. The claim-token banner (campaign picture
    inside a button, plus its close button) is the only thing placed there; empty when no campaign is delivered. Older builds put
    the banner above the footer, newer ones (2026-10) inside it, before the account button, as buttons "Open" and "Close"."""
    lines = d.splitlines(); start = end = None
    for i, l in enumerate(lines):
        if start is None and 'AXGroup/AXLandmarkRegion d="Tasks"' in l: start = i
        elif start is not None and "AXPopUpButton" in l: end = i; break
    if start is None or end is None: return []
    out = []
    for l in lines[start + 1:end]:
        m = re.search(r'AXButton(?:/\w+)? (?:d|t)="([^"]*)"', l)
        if m and m.group(1) not in ("Tasks", "New task"): out.append(m.group(1))
    return out


def dialog_texts():
    d = dump(); lines = d.splitlines(); res = []; inside = None
    for l in lines:
        ind = len(l) - len(l.lstrip())
        if "AXApplicationDialog" in l or "AXDialog" in l: inside = ind; res.append("[dialog]"); continue
        if inside is not None:
            if ind <= inside: inside = None; continue
            m = re.search(r'(?:AXStaticText v|AXButton [dt]|AXHeading t)="([^"]+)"', l)
            if m: res.append(m.group(1))
    return res


def start_plan_state(d):
    """Texts of the Start Plan row and the quota block in Settings > Model settings (read only)."""
    lines = [l.split('v="', 1)[1].rsplit('"', 1)[0] for l in d.splitlines() if "AXStaticText" in l and 'v="' in l]
    sp = "Start Plan" in d
    return dict(start_plan_listed=sp, start_plan_ready=promo_ready(d),
                balance=[t for t in lines if re.search(r"tokens remaining|Today.s balance|used$", t)])


ATTEMPTS_FILE = os.path.join(STATE, "rewards-attempts.log")


def claim_schedule_due(now, hist):
    """Claim attempts of one UTC day: every minute from 10:59 to 12:00, then every 10 minutes until 15:00; none after a success."""
    day = time.strftime("%F", time.gmtime(now)); tm = time.gmtime(now); m = tm.tm_hour * 60 + tm.tm_min
    if hist.get("claimed_day") == day: return False, "already claimed today"
    if 659 <= m < 720: return True, None
    if 720 <= m < 900:
        last = hist.get("last_attempt_ts") or 0
        return (now - last >= 590 or time.strftime("%F", time.gmtime(last)) != day), "every 10 minutes until 15:00 UTC"
    return False, "outside the claim hours (10:59-15:00 UTC)"


def last_marketing_query():
    """Time and verdict of the last marketing-touch query ZCode logged (its own campaign poll), for the attempts log."""
    try:
        logs = sorted(f for f in os.listdir(os.path.join(HOME, ".zcode/v2/logs")) if f.endswith(".log"))
        with open(os.path.join(HOME, ".zcode/v2/logs", logs[-1]), "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 400000)); tail = f.read().decode("utf-8", "replace")
        hit = [l for l in tail.splitlines() if "marketing-touch.query" in l]
        m = re.match(r"\[([\d: -]+)\.\d+\].*marketing-touch\.query (\w+)", hit[-1]) if hit else None
        return dict(at_local=m.group(1), result=m.group(2)) if m else None
    except Exception:
        return None


def poke_campaign_poll():
    """ZCode asks the server for campaigns every 10 minutes and whenever its page turns visible again: minimize and restore the window
    once so the answer is fresh. Caller holds the UI lock; focus is not taken."""
    zc("window", "min", check=False); time.sleep(1.0); zc("window", "unmin", check=False)


def do_rewards(a):
    """Claim the daily token campaign through ZCode's own banner (sidebar, bottom left): AXPress on the banner button, read the result
    dialog, close it with its own acknowledge button. No ZCode or Z.ai endpoint is called by us. Without --claim only reports.
    --scheduled is the launchd entry (every minute): it decides by the UTC clock whether to act, logs every attempt to
    rewards-attempts.log, and stops for the day after a success. The Rewards page of the account menu is the referral program and
    has no claim button (checked)."""
    invalidate_promo_cache()
    now = time.time(); res = dict(ok=True, at=time.strftime("%FT%T%z"), at_utc=time.strftime("%FT%TZ", time.gmtime(now)), claim_requested=bool(a.claim))
    day = time.strftime("%F", time.gmtime(now))
    try: prev = json.load(open(REWARDS_FILE))
    except Exception: prev = {}
    if a.scheduled:
        due, why = claim_schedule_due(now, prev)
        if not due: return dict(ok=True, skipped=why)
        a.claim = True; res["claim_requested"] = True
    with ui_lock():
        retry(need_app, tries=4, delay=3, codes=("no_window", "ui_element_missing", "ax_timeout")); to_workspace(); close_stray_popups()
        poke_campaign_poll()
        btns = []
        for _ in range(6 if a.scheduled else 10):
            time.sleep(1.5); btns = sidebar_banner_buttons(dump())
            if btns: break
        res["banner_buttons"] = btns; res["banner_seen"] = bool(btns); res["last_query"] = last_marketing_query()
        if not btns:
            res.update(status="no_banner", claimed=False, note="no claim banner is shown in the sidebar (nothing delivered right now, or already claimed/closed)")
        elif a.claim:
            act = next((b for b in btns if b and not re.search(r"close|dismiss", b, re.I)), None)
            if act is None: res.update(status="no_action_button", claimed=False)
            else:
                press("AXButton", "=" + act, wait=2.0)
                texts = []
                for _ in range(20):
                    texts = dialog_texts()
                    if len(texts) > 1 and not re.search(r"Verifying|Processing", " ".join(texts)): break
                    time.sleep(1.0)
                res["dialog"] = texts
                joined = " ".join(texts)
                fail = re.search(r"Claim failed|already claimed|quota has been exhausted|ineligible|has ended|unavailable|Sign in", joined, re.I)
                res.update(status="failed" if fail else "claimed", claimed=not fail)
                for lab in ("Got it", "Close", "Close anyway"):    # ZCode's own acknowledge buttons; never "Start using" (it switches the plan)
                    if exists("AXButton", "=" + lab):
                        press("AXButton", "=" + lab, wait=1.0); break
        else: res.update(status="banner_present", claimed=False)
        if res.get("claimed") or not a.scheduled:
            # the Start Plan state, and anything that looks like the promo route ("Global ...", "Building") in Model settings
            press("AXButton", "=Settings", wait=1.5); press("AXButton", "=Model settings", wait=1.5)
            try:
                d = dump(120); res["start_plan"] = start_plan_state(d)
                res["promo_names"] = sorted({m.strip() for m in re.findall(r'(?:v|d|t)="([^"]*(?:Global|Building|Build)[^"]*)"', d)})
            finally:
                if exists("AXButton", "=Back to workspace"): press("AXButton", "=Back to workspace", wait=1.0)
        if res.get("claimed") and res.get("start_plan", {}).get("start_plan_ready") and not [e for e in slots_live()]:
            try: res["route_set"] = set_route("promo"); res["route"] = current_route()
            except BridgeError as e: res["route_error"] = str(e)
    os.makedirs(STATE, exist_ok=True)
    res["claimed_day"] = day if res.get("claimed") else prev.get("claimed_day")
    res["last_claim_at"] = res["at_utc"] if res.get("claimed") else prev.get("last_claim_at")
    res["last_attempt_ts"] = now
    try: json.dump(res, open(REWARDS_FILE, "w"), ensure_ascii=False)
    except OSError: pass
    try:
        with open(ATTEMPTS_FILE, "a") as f:
            f.write(json.dumps({k: res.get(k) for k in ("at_utc", "banner_seen", "banner_buttons", "status", "claimed", "dialog", "last_query", "route", "route_error")}, ensure_ascii=False) + "\n")
    except OSError: pass
    log("rewards %s" % json.dumps({k: res.get(k) for k in ("status", "banner_buttons", "dialog")}, ensure_ascii=False))
    return res


# ---------------------------------------------------------------- route (which plan pays: Z.ai plan or the Start Plan promo)
ROUTES = {"plan": "Z.ai", "promo": "Start Plan"}


def composer_snapshot():
    return json.loads(zc("snapshot"))


def wait_snapshot(predicate, timeout=8.0, initial=None):
    end = time.monotonic() + timeout
    state = initial
    while True:
        state = state if state is not None else composer_snapshot()
        if predicate(state): return state
        if time.monotonic() >= end: raise BridgeError("ui_element_missing", "the expected composer state did not appear: %s" % {k: state.get(k) for k in ("model", "effort", "mode", "provider", "menu_open", "workspace", "back", "ready")})
        time.sleep(0.08); state = None


def open_route_picker(state=None):
    state = state if state is not None else composer_snapshot()
    if state.get("menu_open") and state.get("provider"): return state
    name = (state["model"] + " " + state["effort"].title()) if state.get("model") and state.get("effort") else "Choose model"
    press("AXPopUpButton", "=" + name, wait=0)
    return wait_snapshot(lambda s: s.get("provider") is not None)


def close_model_menu(state=None):
    state = state if state is not None else composer_snapshot()
    if not state.get("menu_open"): return state
    name = (state["model"] + " " + state["effort"].title()) if state.get("model") and state.get("effort") else "Choose model"
    n = len(TRACE)
    press("AXPopUpButton", "=" + name, wait=0)
    del TRACE[n:]
    return wait_snapshot(lambda s: not s.get("menu_open"))


def snapshot_route(state):
    return next((r for r, label in ROUTES.items() if state.get("provider") == label), None)


def current_route():
    """Read the actual composer selection; the settings file only contains a default."""
    state = open_route_picker()
    try: return snapshot_route(state)
    finally: close_model_menu(state)


def promo_ready(d=None):
    """True when Settings > Model settings lists the Start Plan as Ready (claimed and valid), False for Not ready, None if unknown."""
    d = d if d is not None else dump(120)
    lines = d.splitlines()
    for i, line in enumerate(lines):
        if 'AXButton d="Start Plan"' not in line: continue
        indent = len(line) - len(line.lstrip())
        for child in lines[i + 1:]:
            if len(child) - len(child.lstrip()) <= indent: break
            m = re.search(r'AXImage d="(Ready|Not ready)"', child)
            if m: return m.group(1) == "Ready"
    return None


PROMO_CACHE = os.path.join(STATE, "promo-ready.json")


def invalidate_promo_cache():
    try: os.unlink(PROMO_CACHE)
    except FileNotFoundError: pass


def cached_promo_ready():
    try:
        record = json.load(open(PROMO_CACHE))
        if 0 <= time.time() - record["at"] < 30 and isinstance(record.get("ready"), bool): return record["ready"]
    except (OSError, ValueError, KeyError): pass
    return None


def read_promo_ready(cached=True):
    """A short read-through cache, shared by CLI processes. Caller holds the UI lock."""
    if cached:
        ready = cached_promo_ready()
        if ready is not None: return ready
    state = composer_snapshot()
    if not state.get("back"):
        press("AXButton", "=Settings", wait=0)
        wait_snapshot(lambda s: s.get("model_settings"))
    press("AXButton", "=Model settings", wait=0)
    try:
        try: ready = wait_snapshot(lambda s: s.get("ready") is not None).get("ready")
        except BridgeError: return None
        os.makedirs(STATE, exist_ok=True)
        with open(PROMO_CACHE, "w") as f: json.dump(dict(at=time.time(), ready=ready), f)
        return ready
    finally:
        press("AXButton", "=Back to workspace", wait=0)
        wait_snapshot(lambda s: s.get("workspace") and not s.get("back"))


def configure_composer(model=None, effort=None, want="keep", own=None):
    """One model menu owns provider/model/effort changes and their verification."""
    state = open_route_picker()
    changed = False; note = None
    cur = snapshot_route(state)
    desired = cur if want == "keep" else "promo" if want == "free" else want
    ready = None
    try:
        if want == "auto":
            in_window = time.gmtime().tm_hour >= 15 or time.gmtime().tm_hour < 1
            if "flash" in (model or state.get("model") or "").lower() and in_window:
                ready = cached_promo_ready()
                if ready is None:
                    close_model_menu(state); ready = read_promo_ready(); state = open_route_picker()
                desired = "promo" if ready else "plan"
            else: desired = "plan"
        if desired != cur:
            if [e for e in slots_live() if e.get("token") != own]:
                if want == "free": raise BridgeError("promo_unavailable", "other ZCode tasks are running; retry the free model when they finish")
                note = "route %s wanted but other ZCode tasks are running; staying on %s" % (desired, cur)
                desired = cur
            if desired == "promo" and ready is None:
                ready = cached_promo_ready()
                if ready is None:
                    close_model_menu(state); ready = read_promo_ready(); state = open_route_picker()
                if ready is not True:
                    if ready is None: raise BridgeError("promo_status_unknown", "could not read the Start Plan status in ZCode; retry after Model settings has loaded")
                    if want == "free": raise BridgeError("promo_unavailable", "the Start Plan is not Ready in ZCode")
                    if want == "auto": desired = cur
                    else: raise BridgeError("promo_not_ready", "the Start Plan is not Ready in ZCode")
            if desired != cur:
                provider = state.get("provider")
                if not provider: raise BridgeError("route_not_set", "Provider submenu not found")
                press("AXMenuItem", "=Provider: " + provider, wait=0)
                label = ROUTES[desired]
                def offered(s): return next((i for i in s.get("menu_items", []) if i["name"] == label or i["name"].startswith(label + " ")), None)
                state = wait_snapshot(lambda s: offered(s) is not None)
                item = offered(state)
                if not item.get("enabled", True): raise BridgeError("promo_unavailable" if desired == "promo" else "route_not_set", "connection %s is disabled" % label)
                press("AXMenuItem", "=" + item["name"], wait=0)
                state = wait_snapshot(lambda s: snapshot_route(s) == desired or not s.get("menu_open"))
                if not state.get("menu_open"): state = open_route_picker(state)
                if snapshot_route(state) != desired: raise BridgeError("route_not_set", "composer did not select %s" % desired)
                cur = desired; changed = True
        lab = MODELS.get(model, model) if model else state.get("model")
        if lab and (state.get("model") or "").lower() != lab.lower():
            item = next((i for i in state.get("menu_items", []) if re.match(re.escape(lab) + r"(\s|$)", i["name"])), None)
            if not item: raise BridgeError("model_unknown", "model %r not in the selected provider" % lab)
            press("AXMenuItem", "=" + item["name"], wait=0)
            state = wait_snapshot(lambda s: (s.get("model") or "").lower() == lab.lower())
            changed = True
        if effort and state.get("effort") != effort:
            state = open_route_picker(state)
            state = wait_snapshot(lambda s: s.get("effort_index") is not None, initial=state)
            target = EFFORT[effort]
            while state["effort_index"] != target:
                old = state["effort_index"]
                zc("action", "AXSlider", "Effort", "AXIncrement" if old < target else "AXDecrement")
                state = wait_snapshot(lambda s: s.get("effort_index") is not None and s.get("effort_index") != old)
            changed = True
        if state.get("menu_open") and snapshot_route(state) != cur:
            raise BridgeError("route_not_set", "the selected provider changed while configuring the model")
        state = close_model_menu(state)
        if lab and (state.get("model") or "").lower() != lab.lower(): raise BridgeError("model_not_set", "composer model was not applied")
        if effort and state.get("effort") != effort: raise BridgeError("model_not_set", "composer effort was not applied")
        return cur, note, changed
    except BridgeError:
        invalidate_promo_cache()
        raise
    finally:
        close_model_menu()


def set_route(route):
    return configure_composer(want=route)[2]


def choose_route(want, model, own=None, effort=None):
    route, note, _ = configure_composer(model, effort, want, own)
    return route, note


def do_route(a):
    with ui_lock():
        need_app(); close_stray_popups(); to_workspace()
        if not a.set: return dict(ok=True, route=current_route(), promo_ready=read_promo_ready())
        if slots_live(): raise BridgeError("busy", "ZCode tasks are running; the connection is shared by the whole app, change it when they finish")
        changed = set_route(a.set)
        return dict(ok=True, route=a.set, changed=changed)


# ---------------------------------------------------------------- models (what this ZCode offers)
MODELS_FILE = os.path.join(STATE, "models.json")


def parse_model_list(d):
    """[{name, enabled}] from Settings > Model settings > Model list: each row is 'Drag to reorder model', the name, and a switch whose
    label is 'Disable' while the model is enabled and 'Enable' while it is disabled."""
    lines = d.splitlines(); out = []; cur = None; on = False
    for l in lines:
        if "Model list" in l and "AXStaticText" in l: on = True; continue
        if not on: continue
        if 'AXButton d="Drag to reorder model"' in l: cur = None; continue
        m = re.search(r'AXStaticText v="([^"]+)"', l)
        if m and cur is None and not re.fullmatch(r"\d+[MK]?|Vision", m.group(1)): cur = m.group(1); continue
        m = re.search(r'AXCheckBox/AXSwitch d="(Enable|Disable)"', l)
        if m and cur: out.append(dict(name=cur, enabled=m.group(1) == "Disable")); cur = None
    return out


def do_models(a):
    if a.cached: return read_models_ui(a)
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "models.refresh.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if getattr(a, "if_stale", False):
            try:
                cached = json.load(open(MODELS_FILE))
                if cached.get("models") and 0 <= time.time() - cached.get("at", 0) < 86400: return dict(ok=True, **cached)
            except (OSError, ValueError): pass
        return read_models_ui(a)


def read_models_ui(a):
    """The models this ZCode offers on this machine, read from its own screens (Settings > Model settings for the list and the
    enabled switches, the New task composer for ZCode's current default). Cached in ~/.zcode-bridge/models.json; the cache is
    what zcode-acp shows in BB. Reading it takes the window lock for a few seconds and changes nothing."""
    if a.cached:
        try: return dict(ok=True, **json.load(open(MODELS_FILE)))
        except Exception: raise BridgeError("no_cache", "no models cache yet; run `zcbridge models`")
    with ui_lock():
        need_app(); close_stray_popups(); to_workspace()
        zc("pressup", "AXStaticText", "=New task", check=False); wait_for("AXTextArea", ""); time.sleep(0.6)
        cur = composer_model()
        press("AXButton", "=Settings", wait=0); wait_snapshot(lambda s: s.get("model_settings"))
        press("AXButton", "=Model settings", wait=0); wait_for("AXHeading", "=Model settings")
        try: models = parse_model_list(dump(120))
        finally:
            press("AXButton", "=Back to workspace", wait=0)
            wait_snapshot(lambda s: s.get("workspace") and not s.get("back"))
    res = dict(models=models, default=cur[0] if cur else None, effort=cur[1].lower() if cur else None, at=int(time.time()))
    if models:
        try: json.dump(res, open(MODELS_FILE, "w"))
        except OSError: pass
    return dict(ok=True, **res)


def project_more_index(name, d):
    """Index (among all 'More' popups in the tree) of the 'More' popup that belongs to the sidebar row of project `name`."""
    n = -1; seen = False
    for l in d.splitlines():
        if re.search(r'AXButton t="%s"$' % re.escape(name), l.rstrip()): seen = True
        if 'AXPopUpButton d="More"' in l:
            n += 1
            if seen: return n
    return None


def do_project_remove(a):
    """Remove a project from ZCode's list through its own Delete project menu item. ZCode only marks the registry row deleted
    (projects.deleted=1; source: ProjectRepository.deleteProject); no file of the folder is touched, tasks keep their records."""
    real = os.path.realpath(a.folder); p = find_project(real, enclosing=False)
    if not p: return dict(ok=True, removed=False, note="not a ZCode project")
    if len(p["roots"]) != 1: raise BridgeError("not_single_root", "project %r has several folders; remove it in ZCode" % p["name"])
    if any(r.get("directory") and os.path.realpath(r["directory"]) in p["roots"] and r["state"] not in DONE for r in [dict(directory=x["directory"], state=task_state(x["id"])["state"]) for x in conn(DBP).execute("select id,directory from session where parent_id is null")] ):
        raise BridgeError("project_busy", "a task of this project is still running")
    with ui_lock():
        need_app(); close_stray_popups(); to_workspace()
        d = dump(120); i = project_more_index(p["name"], d)
        if i is None and exists("AXButton", "=Show more"):
            press("AXButton", "=Show more", wait=0.8); d = dump(120); i = project_more_index(p["name"], d)
        if i is None: raise BridgeError("project_not_in_sidebar", "project %r is not in the sidebar" % p["name"])
        press("AXPopUpButton", "=More", nth=i, wait=1.0)
        wait_for("AXMenuItem", "Delete project", 4)
        press("AXMenuItem", "Delete project", allow=True, wait=1.2)
        for lab in ("Delete", "Remove", "Confirm"):   # ZCode's own confirm dialog, if it shows one
            if exists("AXApplicationDialog", "") or exists("AXSheet", ""):
                if exists("AXButton", "=" + lab): press("AXButton", "=" + lab, allow=True, wait=1.0); break
    for _ in range(10):
        if not find_project(real, enclosing=False): return dict(ok=True, removed=True, project=p["name"], folder_untouched=os.path.isdir(real))
        time.sleep(0.5)
    raise BridgeError("project_not_removed", "Delete project was pressed but %r is still listed" % p["name"])


# ---------------------------------------------------------------- listing
def do_tasks(a):
    c = conn(DBP); where = ["parent_id is null"]; args = []
    arch = {r[0] for r in conn(IDXP).execute("select task_id from tasks where archived=1")}
    if a.folder: where.append("directory=?"); args.append(os.path.realpath(a.folder))
    rows = c.execute("select id,title,directory,time_created,time_updated,last_outcome from session where %s order by time_updated desc" % " and ".join(where), args).fetchall()
    rows = [r for r in rows if (r["id"] in arch) == bool(a.archived)][:a.limit]
    return dict(ok=True, tasks=[dict(task_id=r["id"], title=r["title"], directory=r["directory"], created=r["time_created"], updated=r["time_updated"], archived=r["id"] in arch, outcome=r["last_outcome"]) for r in rows])


def do_automations_list(a):
    c = conn(IDXP)
    rows = [dict(id=r["automation_id"], title=r["title"], cron=r["cron_expr"], schedule=r["schedule_rule"], prompt=r["prompt"][:200], enabled=bool(r["enabled"]), status=r["lifecycle_status"], workspace=r["workspace_path"],
                 mode=r["mode"], model_selection=r["model_selection"], next_run_at=r["next_run_at"], last_run_at=r["last_run_at"], runs=r["run_count"], running=bool(r["running"]), last_error=r["last_error"])
            for r in c.execute("select * from automations order by created_at")]
    runs = [dict(r) for r in c.execute("select run_id,automation_id,trigger,dispatch_status,outcome,session_id,error,created_at from automation_runs order by created_at desc limit 20")]
    idle = [dict(r) for r in c.execute("select off_peak_task_id,title,status,queued_at,session_id,failure_reason from off_peak_tasks order by queued_at desc limit 20")]
    return dict(ok=True, automations=rows, recent_runs=runs, idle_time_tasks=idle)


def read_prompt(a):
    if getattr(a, "prompt_file", None): return open(a.prompt_file).read()
    if a.prompt == "-": return sys.stdin.read()
    if not a.prompt: raise BridgeError("no_prompt", "give --prompt TEXT, --prompt-file FILE or --prompt -")
    return a.prompt


# ---------------------------------------------------------------- capabilities (disk, names only)
def do_capabilities(a):
    """Plugins, MCP servers and skills ZCode would load. Disk only; MCP env/headers are never read out."""
    def skills_in(d):
        return sorted(n for n in os.listdir(d) if os.path.isdir(os.path.join(d, n)) and not n.startswith(".")) if os.path.isdir(d) else []
    out = {}
    cache = os.path.join(HOME, ".zcode/cli/plugins/cache")
    out["plugins"] = [dict(market=m, name=p, versions=sorted(os.listdir(os.path.join(cache, m, p)))) for m in sorted(os.listdir(cache)) if os.path.isdir(os.path.join(cache, m)) for p in sorted(os.listdir(os.path.join(cache, m)))] if os.path.isdir(cache) else []
    mcp = {}
    for label, p in [("user-config", os.path.join(HOME, ".zcode/cli/config.json")), ("agents-user", os.path.join(HOME, ".agents/mcp.json"))] + \
            ([("project", os.path.join(os.path.realpath(a.folder), ".mcp.json")), ("project-agents", os.path.join(os.path.realpath(a.folder), ".agents/mcp.json"))] if a.folder else []):
        if os.path.exists(p):
            try:
                j = json.load(open(p)); srv = (j.get("mcp") or {}).get("servers") or j.get("mcpServers") or {}
                mcp[label] = sorted(srv)
            except Exception as e: mcp[label] = "unreadable: %s" % e
    for pl in out["plugins"]:
        f = os.path.join(cache, pl["market"], pl["name"], pl["versions"][-1], ".mcp.json")
        if os.path.exists(f):
            try: mcp["plugin:" + pl["name"]] = sorted((lambda j: j.get("mcpServers") or j)(json.load(open(f))))
            except Exception: pass
    out["mcp_servers"] = mcp
    sk = {"user:~/.agents/skills": skills_in(os.path.join(HOME, ".agents/skills")), "user:~/.claude/skills": skills_in(os.path.join(HOME, ".claude/skills")), "user:~/.zcode/skills": skills_in(os.path.join(HOME, ".zcode/skills"))}
    if a.folder:
        for d in (".zcode/skills", ".agents/skills"): sk["project:" + d] = skills_in(os.path.join(os.path.realpath(a.folder), d))
    out["skills"] = {k: dict(count=len(v), names=v if a.names else v[:0]) for k, v in sk.items()}
    out["instructions"] = {p: os.path.exists(os.path.join(HOME, p)) for p in (".zcode/AGENTS.md",)}
    if a.folder: out["instructions"]["project AGENTS.md"] = os.path.exists(os.path.join(os.path.realpath(a.folder), "AGENTS.md"))
    if a.ui:
        with ui_lock():
            need_app(); guard()
            press("AXButton", "=Settings", wait=1.5); press("AXButton", "=Plugins", wait=1.5)
            out["ui_counts"] = {m.group(1): int(m.group(2)) for m in re.finditer(r'AXRadioButton/AXTabButton t="(Plugins|MCP|Skills) (\d+)"', dump())}
            press("AXButton", "=Back to workspace", wait=1.0)
    return dict(ok=True, **out)


# ---------------------------------------------------------------- doctor / ui
def do_doctor(a):
    chk = {}
    chk["zcax"] = os.path.exists(ZCAX)
    chk["frontmost_now"] = frontmost(); chk["focus_policy"] = "foreground" if FOREGROUND else "background"; chk["window"] = win_state()
    try:
        d = dump(); chk["app_running"] = True; chk["session_expired"] = bool(re.search(r"session has expired|Sign in again", d))
        for lab in ("Switch mode", "Send", "Add context"):
            chk["label:" + lab] = lab in d
        chk["mode"] = current_mode(d); chk["plan_chip"] = "Remove Plan from the next submission" in d
    except BridgeError as e:
        chk["app_running"] = e.code != "not_running"; chk["error"] = str(e)
    chk["db_readable"] = os.path.exists(DBP); chk["index_readable"] = os.path.exists(IDXP)
    try: chk["projects"] = len(projects())
    except Exception as e: chk["projects_error"] = str(e)
    ok = chk.get("app_running") and not chk.get("session_expired") and chk["db_readable"]
    return dict(ok=bool(ok), checks=chk)


def do_ui(a):
    return dict(ok=True, tree=dump(a.depth))


# ---------------------------------------------------------------- watch (JSON lines)
def watch_events(task, seen, cursor=None):
    """New or changed parts of a task as events. `seen` maps part id -> fingerprint and is updated in place.
    text/reasoning: {event, id, role, text (all of it so far), delta (the new tail), reset (true when the text changed in the middle)}.
    tool: {event:"tool", id (the call id), tool, status (pending|running|completed|error), input, output, error}, once per status change.
    ZCode writes a text or reasoning part to its db at the end of each model step (no earlier), so `text` arrives once per step."""
    out = []
    for mt, seq, pid, role, j in parts(task, (cursor or {}).get("since", 0), cursor):
        t = j.get("type")
        if t in ("text", "reasoning"):
            txt = j.get("text") or ""
            prev = seen.get(pid, "")
            if not txt or txt == prev: continue
            seen[pid] = txt
            ev = dict(event=t, id=pid, role=role, text=txt)
            if txt.startswith(prev): ev["delta"] = txt[len(prev):]
            else: ev["delta"] = txt; ev["reset"] = True
            out.append(ev)
        elif t == "tool":
            st = j.get("state") or {}; status = st.get("status")
            key = (j.get("callID") or pid, status)
            if seen.get(pid) == key: continue
            seen[pid] = key
            ev = dict(event="tool", id=j.get("callID") or pid, part=pid, role=role, tool=j.get("tool"), status=status, input=st.get("input"))
            if st.get("output") is not None: ev["output"] = st["output"] if isinstance(st["output"], str) else json.dumps(st["output"], ensure_ascii=False)
            if st.get("error"): ev["error"] = st["error"]
            out.append(ev)
    return out


def do_watch(a):
    seen = {}; cursor = {"since": getattr(a, "since", 0)}; end = time.time() + a.timeout
    while True:
        st = task_state(a.task)   # state first, then one more scan: a part written right before the state flipped is not lost
        for ev in watch_events(a.task, seen, cursor): print(json.dumps(ev, ensure_ascii=False), flush=True)
        if st["state"] in DONE or st["state"] == "waiting_approval" or time.time() > end:
            print(json.dumps(dict(event="state", cursor=cursor["since"], **{k: st[k] for k in ("state", "pending_approvals", "tokens", "error") if k in st}), ensure_ascii=False), flush=True); return None
        time.sleep(a.poll)


# ---------------------------------------------------------------- CLI
def main(argv=None):
    ap = argparse.ArgumentParser(prog="zcbridge", description=__doc__.split("\n")[0])
    sp = ap.add_subparsers(dest="cmd", required=True)
    def add(name, fn, **kw):
        p = sp.add_parser(name, **kw); p.set_defaults(fn=fn); p.add_argument("--json", action="store_true", help="(default) JSON output")
        p.add_argument("--background", action="store_true", help="(default) never activate ZCode for more than a paste, never send keystrokes")
        p.add_argument("--foreground", action="store_true", help="old path: make ZCode frontmost, paste with Cmd+V, press keys, then restore the previous app"); return p
    p = add("version", lambda a: dict(ok=True, version=VERSION, zcax=ZCAX, zcax_found=os.path.exists(ZCAX)), help="bridge version")
    p = add("doctor", do_doctor, help="check app, labels, stores")
    p = add("ui", do_ui, help="dump the accessibility tree"); p.add_argument("--depth", type=int, default=60)
    p = add("projects", lambda a: dict(ok=True, projects=projects()), help="projects known to ZCode")
    def project_add(a):
        p = find_project(a.folder)
        if p: return dict(ok=True, project=p, created=False)
        with ui_lock():
            need_app(); guard(); to_workspace(); return dict(ok=True, project=create_project(a.folder), created=True)
    p = add("project-add", project_add, help="register a folder as a ZCode project (folder panel + ZCode's trust dialog)"); p.add_argument("folder")
    p = add("project-remove", do_project_remove, help="remove a folder's project from ZCode's list (registry only, no file is touched)"); p.add_argument("folder")
    p = add("tasks", do_tasks, help="list tasks"); p.add_argument("--folder"); p.add_argument("--limit", type=int, default=30); p.add_argument("--archived", action="store_true")
    def sendargs(p):
        p.add_argument("--prompt"); p.add_argument("--prompt-file"); p.add_argument("--wait", action="store_true"); p.add_argument("--timeout", type=int, default=900); p.add_argument("--poll", type=float, default=2.0)
        p.add_argument("--approve", default="deny", choices=["deny", "project", "manual"], help="policy for permission cards while waiting (default deny)")
        p.add_argument("--queue-timeout", type=float, default=float(os.environ.get("ZCBRIDGE_QUEUE_TIMEOUT") or 900), help="seconds to wait for a free parallel slot (ZCODE_MAX_PARALLEL); 0 = fail at once with parallel_limit")
    p = add("send", do_send, help="new task: project folder, model, effort, mode"); sendargs(p)
    p.add_argument("--folder", help="project folder (omit = work outside a project)"); p.add_argument("--model", default="flash"); p.add_argument("--effort", choices=list(EFFORT))
    p.add_argument("--mode", choices=list(MODES), help="ask|plan|auto|full (default: config default_mode, else ask)"); p.add_argument("--allow-autonomous", action="store_true"); p.add_argument("--allow-full", action="store_true")
    p.add_argument("--no-tag", action="store_true", help="do not prefix the prompt with [bb:xxxxxx], the tag that makes the task findable in the sidebar")
    p.add_argument("--no-create-project", action="store_true", help="fail with project_missing instead of registering an unknown folder as a ZCode project")
    p.add_argument("--route", default=os.environ.get("ZCODE_ROUTE") or "keep", choices=["keep", "auto", "plan", "promo", "free"], help="which plan pays: keep (default, ZCode's current choice), plan, promo (Start Plan), auto (promo for Flash when Ready), free (Start Plan or refuse with promo_unavailable)")
    p = add("continue", do_continue, help="follow-up turn in an existing task"); sendargs(p); p.add_argument("task"); p.add_argument("--force", action="store_true")
    p.add_argument("--mode", choices=list(MODES), help="set this task's mode before sending (default: leave it)"); p.add_argument("--allow-autonomous", action="store_true"); p.add_argument("--allow-full", action="store_true")
    p = add("mode-reset", do_mode_reset, help="put ZCode's composer back on its resting mode, Plan off (New task screen, or --task TASK)"); p.add_argument("--task")
    p.add_argument("--to", default=os.environ.get("ZCODE_REST_MODE") or "full", choices=["ask", "auto", "full", "none"], help="resting mode (default full; none = leave the mode)"); p.add_argument("--model"); p.add_argument("--effort", choices=list(EFFORT))
    p = add("slots", do_slots, help="running tasks that hold a parallel slot, and the limit (ZCODE_MAX_PARALLEL)")
    p = add("status", lambda a: dict(ok=True, **task_state(a.task)), help="state of a task"); p.add_argument("task")
    p = add("wait", lambda a: dict(ok=True, task_id=a.task, **wait_task(a.task, a.timeout, a.approve, a.poll)), help="wait for the task, applying the approve policy")
    p.add_argument("task"); p.add_argument("--timeout", type=int, default=900); p.add_argument("--poll", type=float, default=2.0); p.add_argument("--approve", default="deny", choices=["deny", "project", "manual"])
    p = add("result", lambda a: dict(ok=True, task_id=a.task, state=task_state(a.task)["state"], answer=final_answer(a.task), **({"tool_calls": tool_calls(a.task)} if a.tools else {})), help="final answer"); p.add_argument("task"); p.add_argument("--tools", action="store_true")
    p = add("watch", do_watch, help="stream parts as JSON lines until the task ends or needs approval"); p.add_argument("task"); p.add_argument("--timeout", type=int, default=900); p.add_argument("--poll", type=float, default=1.5); p.add_argument("--since", type=int, default=0)
    p = add("cancel", do_cancel, help="press Stop on a running task"); p.add_argument("task")
    p = add("archive", do_archive, help="archive a task (More > Archive task)"); p.add_argument("task")
    p = add("approvals", lambda a: dict(ok=True, task_id=a.task, pending=pending(a.task)), help="pending approval cards (from the db)"); p.add_argument("task")
    def do_decide(a, choice):
        s = session_row(a.task); got = []
        pend = pending(a.task)
        if not pend: return dict(ok=True, task_id=a.task, note="nothing pending")
        for it in pend[:1]:
            if choice == "allow" and a.policy:
                v, why = decide(it, a.project or s["directory"], a.policy)
                if v != "allow": choice_ = "deny"; reason = why
                else: choice_ = "allow"; reason = why
            else: choice_, reason = choice, "explicit"
            if choice_ == "allow" and not a.policy and not a.yes:
                raise BridgeError("policy", "approve needs --policy project (in-project edits only) or --yes for this single call")
            with ui_lock():
                open_task(a.task); answer_card(choice_)
            got.append(dict(call_id=it["call_id"], tool=it["tool"], paths=call_paths(it), applied=choice_, reason=reason))
        return dict(ok=True, task_id=a.task, actions=got, state=task_state(a.task)["state"])
    p = add("approve", lambda a: do_decide(a, "allow"), help="allow ONE pending call once"); p.add_argument("task"); p.add_argument("--policy", choices=["project"]); p.add_argument("--project"); p.add_argument("--yes", action="store_true")
    p = add("deny", lambda a: do_decide(a, "deny"), help="deny the pending call"); p.add_argument("task"); p.add_argument("--policy"); p.add_argument("--project"); p.add_argument("--yes", action="store_true")
    p = add("usage", do_usage, help="token usage from the db; --quota reads ZCode's quota popover"); p.add_argument("--days", type=int, default=7); p.add_argument("--quota", action="store_true")
    p = add("rewards", do_rewards, help="daily claimable-token banner of ZCode: report, or --claim it (AX only)"); p.add_argument("--claim", action="store_true"); p.add_argument("--scheduled", action="store_true", help="for launchd: claim only in the hours 11, 12, 15 UTC and until a claim succeeded today")
    p = add("route", do_route, help="which plan pays for ZCode tasks: show, or --set plan|promo (Start Plan)"); p.add_argument("--set", choices=list(ROUTES))
    p = add("models", do_models, help="models this ZCode offers (enabled/disabled) and its default; --cached reads the last result"); p.add_argument("--cached", action="store_true"); p.add_argument("--if-stale", action="store_true")
    p = add("capabilities", do_capabilities, help="plugins, MCP servers, skills, instructions ZCode loads (names only)"); p.add_argument("--folder"); p.add_argument("--names", action="store_true"); p.add_argument("--ui", action="store_true", help="also read the counts shown in Settings > Plugins")
    p = add("automations", do_automations_list, help="list automations, runs and idle-time tasks (read-only)")
    p.add_argument("action", nargs="?", default="list", choices=["list", "create", "run", "pause", "resume", "delete"]); p.add_argument("id", nargs="?")
    p.add_argument("--title"); p.add_argument("--schedule", default="month", help="hour|day|weekday|week|month (default month; ZCode's default time of day)")
    p.add_argument("--folder"); p.add_argument("--model", default="flash"); p.add_argument("--effort", choices=list(EFFORT), default="low")
    p.add_argument("--prompt"); p.add_argument("--prompt-file"); p.add_argument("--wait", action="store_true"); p.add_argument("--timeout", type=int, default=600)
    p.add_argument("--approve", default="deny", choices=["deny", "project", "manual"])
    def autos(a):
        if a.action == "list": return do_automations_list(a)
        if a.action == "create":
            if not a.title: raise BridgeError("no_title", "--title is required")
            return do_auto_create(a)
        if not a.id: raise BridgeError("no_id", "automation id required")
        return {"run": do_auto_run, "pause": lambda x: do_auto_toggle(x, "Pause"), "resume": lambda x: do_auto_toggle(x, "Continue"), "delete": do_auto_delete}[a.action](a)
    p.set_defaults(fn=autos)
    from_ext = globals().get("extend_cli")
    if from_ext: from_ext(sp, add)
    a = ap.parse_args(argv)
    global FOREGROUND
    if a.foreground and a.background:
        print(json.dumps(dict(ok=False, error=dict(code="bad_flags", message="--foreground and --background are exclusive")))); return 1
    FOREGROUND = bool(a.foreground)
    try:
        res = a.fn(a)
        if isinstance(res, dict) and a.cmd in ("send", "continue", "mode-reset"):
            res["ui_trace"] = dict(menus_opened=list(TRACE), count=len(TRACE))
        if isinstance(res, dict) and FOCUS.get("before") is not None:
            after = frontmost(); res["focus"] = dict(before=FOCUS["before"], after=after, unchanged=FOCUS["before"] == after, mode="foreground" if FOREGROUND else "background")
    except BridgeError as e:
        log("%s %s" % (a.cmd, e)); print(json.dumps(dict(ok=False, error=dict(code=e.code, message=str(e), **e.extra)), ensure_ascii=False)); return 1
    except Exception as e:
        log("%s crash %r" % (a.cmd, e)); print(json.dumps(dict(ok=False, error=dict(code="internal", message=repr(e)))), ensure_ascii=False); return 1
    if res is not None: print(json.dumps(res, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
